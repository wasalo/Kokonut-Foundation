{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@lib/*": ["src/lib/*"],
      "@components/*": ["src/components/*"]
    },
    "types": ["@cloudflare/workers-types", "astro/client"]
  },
  "include": ["src", "tests", "astro.config.mjs"],
  "exclude": ["dist", ".astro", "node_modules"]
}