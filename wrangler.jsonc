{
  "name": "kokonut-foundation",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    { "pattern": "kokonut.foundation", "custom_domain": true },
    { "pattern": "www.kokonut.foundation", "custom_domain": true },
    { "pattern": "staging.kokonut.foundation", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kokonut-foundation-db",
      "database_id": "9dc1ce8c-40c0-4f9f-92c3-80c105dc8b40",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "kokonut-foundation-media" }
  ],
  "kv_namespaces": [
    { "binding": "CONFIG", "id": "7a52205d8b6c4aac854e70adedbbbc1a" }
  ],
  "queues": {
    "producers": [{ "binding": "SYNC_QUEUE", "queue": "kokonut-sync-queue" }],
    "consumers": [{ "queue": "kokonut-sync-queue", "max_batch_size": 10, "max_batch_timeout": 30 }]
  },
  "triggers": {
    "crons": ["0 2 * * *"]
  },
  "workflows": [
    { "binding": "PUBLISH_REPORT", "name": "publish-report", "class_name": "PublishReportWorkflow" }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFfK8jwK4GUIbfFN",
    "ADMIN_DEV_BYPASS": "false"
  },
  "env": {
    "preview": {
      "vars": {
        "ENVIRONMENT": "preview",
        "ADMIN_DEV_BYPASS": "true",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFfK8jwK4GUIbfFN"
      },
      "workflows": [
        { "binding": "PUBLISH_REPORT", "name": "publish-report-preview", "class_name": "PublishReportWorkflow" }
      ],
      "d1_databases": [
        { "binding": "DB", "database_name": "kokonut-foundation-db-preview", "database_id": "0ad3a4e9-b1f7-4abf-b655-0e821350369f", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "kokonut-foundation-media-preview" }
      ],
      "kv_namespaces": [
        { "binding": "CONFIG", "id": "271b7876f4274571bd043f6fe2af8842" }
      ],
      "queues": {
        "producers": [{ "binding": "SYNC_QUEUE", "queue": "kokonut-sync-queue-preview" }],
        "consumers": [{ "queue": "kokonut-sync-queue-preview", "max_batch_size": 10, "max_batch_timeout": 30 }]
      }
    }
  }
}
