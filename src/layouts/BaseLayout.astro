---
import "../styles/global.css";
import SeoHead from "@components/seo/SeoHead.astro";
import SiteNav from "@components/layout/SiteNav.astro";
import SiteFooter from "@components/layout/SiteFooter.astro";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  jsonLd?: Record<string, unknown>;
}
const { title, description = "Kokonut Foundation — Growing Regenerative Farms Through Community Governance", canonical, jsonLd } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <SeoHead title={title} description={description} canonical={canonical} jsonLd={jsonLd} />
    <!-- Cloudflare Web Analytics -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "PLACEHOLDER"}'></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteNav />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
