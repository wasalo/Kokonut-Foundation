---
import "../styles/global.css";
import SeoHead from "@components/seo/SeoHead.astro";
import SiteNav from "@components/layout/SiteNav.astro";
import SiteFooter from "@components/layout/SiteFooter.astro";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  jsonLd?: Record<string, unknown>;
  lang?: string;
}
const { title, description = "Kokonut Foundation — Growing Regenerative Farms Through Community Governance", canonical, jsonLd, lang = "en" } = Astro.props;
const env = (Astro.locals as any).runtime?.env ?? {};
const analyticsToken = env.CF_WEB_ANALYTICS_TOKEN;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <SeoHead title={title} description={description} canonical={canonical} jsonLd={jsonLd} />
    <!-- Set the theme before first paint to avoid a flash of the wrong palette. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("kokonut-theme");
          var theme = stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
    <!-- Cloudflare Web Analytics -->
    {analyticsToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analyticsToken })}></script>
    )}
    <script>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js").catch(() => {});
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteNav />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
