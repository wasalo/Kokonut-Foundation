---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  type?: "button" | "submit";
}
const { href, variant = "primary", type = "button" } = Astro.props;
const base = "inline-flex items-center justify-center px-4 py-2 rounded-md text-sm font-medium transition";
const variants = {
  primary: "bg-primary text-on-primary hover:bg-primary-dark",
  secondary: "bg-secondary text-on-secondary hover:opacity-90",
  ghost: "text-primary hover:bg-surface-muted",
};
const cls = `${base} ${variants[variant]}`;
---
{href ? (
  <a href={href} class={cls}><slot /></a>
) : (
  <button type={type} class={cls}><slot /></button>
)}
