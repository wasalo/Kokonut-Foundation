---
interface Props { text: string; }
const { text } = Astro.props;
---
<span class="relative group inline-block">
  <slot />
  <span class="absolute bottom-full left-1/2 -translate-x-1/2 mb-1 hidden group-hover:block bg-strong text-surface text-xs rounded px-2 py-1 whitespace-nowrap z-10">{text}</span>
</span>