---
interface Props { tabs: { id: string; label: string }[]; }
const { tabs } = Astro.props;
---
<div class="border-b border-border flex gap-1">
  {tabs.map((t, i) => (
    <button data-tab={t.id} class={`px-4 py-2 text-sm ${i === 0 ? "border-b-2 border-primary text-primary" : "text-muted"}`}>{t.label}</button>
  ))}
</div>
<div class="mt-4">
  <slot />
</div>