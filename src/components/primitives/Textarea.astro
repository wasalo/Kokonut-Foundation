---
interface Props { name: string; placeholder?: string; required?: boolean; rows?: number; value?: string; class?: string; }
const { name, placeholder, required = false, rows = 4, value, class: cls = "" } = Astro.props;
---
<textarea name={name} placeholder={placeholder} required={required} rows={rows} class={`w-full rounded-md border border-border px-3 py-2 text-sm ${cls}`}>{value}</textarea>