---
interface Props {
  slug: string;
  name: string;
  summary: string;
  status?: string;
  country?: string;
  sdgs?: number[];
}
const { slug, name, summary, status = "active", country, sdgs = [] } = Astro.props;
---
<a href={`/projects/${slug}`} class="block rounded-lg border border-border bg-surface p-6 hover:shadow-md transition">
  <div class="flex items-start justify-between">
    <h3 class="font-semibold text-strong">{name}</h3>
    <span class="text-xs px-2 py-0.5 rounded bg-primary/10 text-primary">{status}</span>
  </div>
  <p class="mt-2 text-sm text-muted">{summary}</p>
  <div class="mt-3 flex items-center gap-3 text-xs text-muted">
    {country && <span>{country}</span>}
    {sdgs.length > 0 && <span>SDGs: {sdgs.join(", ")}</span>}
  </div>
</a>
