---
interface Props { title: string; type?: string; evidenceClass?: string; maturity?: string; visibility?: string; href?: string; }
const { title, type = "Document", evidenceClass = "measurement", maturity = "structured", visibility = "public", href } = Astro.props;
---
<div class="rounded-lg border border-border bg-surface p-4">
  <h3 class="font-semibold text-strong text-sm">{title}</h3>
  <p class="mt-1 text-xs text-muted">{type} · {evidenceClass} · {maturity} · {visibility}</p>
  {href && <a href={href} class="mt-2 inline-block text-xs text-primary">View →</a>}
</div>