---
import { getTranslator, localePath, resolveLocale } from "@lib/i18n";

const locale = resolveLocale(Astro);
const t = getTranslator(locale);
const path = (p: string) => localePath(locale, p);

const cols = [
  {
    title: "Platform",
    links: [
      { href: "/projects", key: "nav.projects" },
      { href: "/impact", key: "nav.impact" },
      { href: "/transparency", key: "nav.transparency" },
      { href: "/resources", key: "nav.resources" },
    ],
  },
  {
    title: "Organization",
    links: [
      { href: "/about", key: "nav.about" },
      { href: "/about/foundation", label: "The Foundation" },
      { href: "/about/team", label: "Team" },
      { href: "/partners", key: "nav.partners" },
    ],
  },
  {
    title: "Participate",
    links: [
      { href: "/support", key: "nav.support" },
      { href: "/contact", key: "nav.contact" },
      { href: "/how-it-works", key: "nav.how" },
      { href: "/explorer", key: "nav.explorer" },
    ],
  },
];
---
<footer class="border-t border-border bg-surface-muted mt-16">
  <div class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-4 gap-8">
    <div>
      <p class="font-bold text-strong">Kokonut Foundation</p>
      <p class="text-sm text-muted mt-2">Growing Regenerative Farms Through Community Governance.</p>
    </div>
    {cols.map((c) => (
      <div>
        <p class="font-semibold text-strong text-sm">{c.title}</p>
        <ul class="mt-3 space-y-2">
          {c.links.map((l) => (
            <li><a href={path(l.href)} class="text-sm text-muted hover:text-primary">{l.key ? t(l.key) : l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="max-w-7xl mx-auto px-4 py-4 border-t border-border text-xs text-muted flex flex-wrap justify-between gap-2">
    <span>© {new Date().getFullYear()} Kokonut Foundation. {t("footer.rights")}</span>
    <span class="flex gap-3">
      <a href="https://x.com/KokonutFDN" class="hover:text-primary" target="_blank" rel="noopener">X</a>
      <a href="https://www.instagram.com/kokonut.foundation/" class="hover:text-primary" target="_blank" rel="noopener">Instagram</a>
      <a href="https://link.kokonut.network/discord" class="hover:text-primary" target="_blank" rel="noopener">Discord</a>
      <a href="mailto:info@kokonut.foundation" class="hover:text-primary">Email</a>
      <a href={path("/transparency")} class="hover:text-primary">{t("footer.transparency")}</a>
    </span>
  </div>
</footer>
