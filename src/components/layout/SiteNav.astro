---
const links = [
  { href: "/", label: "Home" },
  { href: "/how-it-works", label: "How It Works" },
  { href: "/projects", label: "Projects" },
  { href: "/impact", label: "Impact" },
  { href: "/transparency", label: "Transparency" },
  { href: "/partners", label: "Partners" },
  { href: "/resources", label: "Resources" },
  { href: "/about", label: "About" },
  { href: "/support", label: "Support" },
];
---
<header class="border-b border-border bg-surface">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="font-bold text-strong text-lg">Kokonut Foundation</a>
    <nav aria-label="Primary" class="hidden md:flex gap-1">
      {links.map((l) => (
        <a href={l.href} class="px-3 py-2 rounded-md text-sm hover:bg-surface-muted">{l.label}</a>
      ))}
    </nav>
    <a href="/contact" class="px-4 py-2 rounded-md bg-primary text-white text-sm font-medium">Contact</a>
  </div>
</header>
