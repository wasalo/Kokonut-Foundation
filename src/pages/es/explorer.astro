---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
---
<BaseLayout title="Explorador — Kokonut Foundation" description="Explorador de datos.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Explorador</h1>
    <p class="mt-4 text-muted">Explora datos, impacto, evidencia y transparencia de la Fundación.</p>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
      <a href="/es/projects" class="rounded-lg border border-border bg-surface p-5"><h2 class="font-semibold text-strong">Proyectos</h2></a>
      <a href="/es/impact" class="rounded-lg border border-border bg-surface p-5"><h2 class="font-semibold text-strong">Impacto</h2></a>
      <a href="/es/transparency" class="rounded-lg border border-border bg-surface p-5"><h2 class="font-semibold text-strong">Transparencia</h2></a>
    </div>
  </section>
</BaseLayout>
