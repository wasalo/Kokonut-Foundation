---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
---
<BaseLayout title="Acerca de — Kokonut Foundation" description="Sobre la Fundación.">
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Acerca de Kokonut Foundation</h1>
    <p class="mt-4 text-muted">Kokonut Foundation es la primera organización sin fines de lucro que implementa el Kokonut Framework. Cultiva fincas regenerativas a través de gobernanza comunitaria, datos públicos y valor regenerativo.</p>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
      <a href="/es/about/foundation" class="block rounded-lg border border-border bg-surface p-6 hover:shadow-md">
        <h3 class="font-semibold text-strong">La Fundación</h3>
        <p class="mt-2 text-sm text-muted">Misión, modelo, relación con Kokonut Network.</p>
      </a>
      <a href="/es/about/team" class="block rounded-lg border border-border bg-surface p-6 hover:shadow-md">
        <h3 class="font-semibold text-strong">Equipo</h3>
        <p class="mt-2 text-sm text-muted">Las personas detrás de la Fundación.</p>
      </a>
    </div>
  </section>
</BaseLayout>
