---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
---
<BaseLayout title="Cómo Funciona — Kokonut Foundation" description="Fondo, crece, verifica, repite.">
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Cómo Funciona</h1>
    <p class="mt-6 text-muted">Kokonut Foundation dirige recursos hacia la capacidad productiva regenerativa.</p>
    <div class="mt-10 space-y-6">
      <div><h2 class="text-xl font-semibold text-strong">Fondo</h2><p class="text-muted">Los recursos se dirigen a la capacidad productiva regenerativa.</p></div>
      <div><h2 class="text-xl font-semibold text-strong">Crece</h2><p class="text-muted">Las fincas aprobadas implementan agricultura regenerativa, infraestructura y gestión.</p></div>
      <div><h2 class="text-xl font-semibold text-strong">Verifica</h2><p class="text-muted">La actividad genera evidencia medible: observaciones, satélite, cosechas, suelo, fotografías.</p></div>
      <div><h2 class="text-xl font-semibold text-strong">Repite</h2><p class="text-muted">Los sistemas regenerativos continúan generando valor ecológico, económico y social.</p></div>
    </div>
  </section>
</BaseLayout>
