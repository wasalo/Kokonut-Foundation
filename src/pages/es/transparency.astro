---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
---
<BaseLayout title="Transparencia — Kokonut Foundation" description="Rendición de cuentas.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Transparencia</h1>
    <p class="mt-4 text-muted">Información de rendición de cuentas pública consolidada en un solo lugar.</p>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
      <a href="/es/transparency/governance" class="block rounded-lg border border-border bg-surface p-6 hover:shadow-md">
        <h3 class="font-semibold text-strong">Gobernanza</h3>
        <p class="mt-2 text-sm text-muted">Gobernanza de la Fundación.</p>
      </a>
      <a href="/es/transparency/treasury" class="block rounded-lg border border-border bg-surface p-6 hover:shadow-md">
        <h3 class="font-semibold text-strong">Tesorería</h3>
        <p class="mt-2 text-sm text-muted">Billeteras, saldos, gastos.</p>
      </a>
      <a href="/es/transparency/attestations" class="block rounded-lg border border-border bg-surface p-6 hover:shadow-md">
        <h3 class="font-semibold text-strong">Atestaciones</h3>
        <p class="mt-2 text-sm text-muted">Atestaciones públicas.</p>
      </a>
      <a href="/es/transparency/reports" class="block rounded-lg border border-border bg-surface p-6 hover:shadow-md">
        <h3 class="font-semibold text-strong">Reportes</h3>
        <p class="mt-2 text-sm text-muted">Reportes publicados.</p>
      </a>
    </div>
  </section>
</BaseLayout>
