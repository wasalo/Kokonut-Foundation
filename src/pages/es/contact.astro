---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
---
<BaseLayout title="Contacto — Kokonut Foundation" description="Contacta la Fundación.">
  <section class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Contacto</h1>
    <p class="mt-4 text-muted">Ponte en contacto con la Fundación.</p>
    <p class="mt-4 text-sm text-muted">Email: <a href="mailto:info@kokonut.foundation" class="text-primary">info@kokonut.foundation</a></p>
    <p class="mt-2 text-sm text-muted">Discord: <a href="https://link.kokonut.network/discord" class="text-primary" target="_blank" rel="noopener">Únete</a></p>
  </section>
</BaseLayout>
