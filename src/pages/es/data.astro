---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
---
<BaseLayout title="Datos — Kokonut Foundation" description="Datos legibles por máquina.">
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Datos</h1>
    <p class="mt-4 text-muted">Datos y APIs legibles por máquina de la Fundación.</p>
    <ul class="mt-6 space-y-2 text-sm">
      <li><a href="/openapi.json" class="text-primary">Especificación OpenAPI</a></li>
      <li><a href="/api/v1/projects" class="text-primary">Proyectos (JSON)</a></li>
      <li><a href="/api/v1/metrics" class="text-primary">Métricas (JSON)</a></li>
      <li><a href="/api/v1/farms" class="text-primary">Fincas (JSON)</a></li>
      <li><a href="/llms.txt" class="text-primary">llms.txt</a></li>
      <li><a href="/sitemap.xml" class="text-primary">Sitemap</a></li>
    </ul>
  </section>
</BaseLayout>
