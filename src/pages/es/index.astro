---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
---
<BaseLayout title="Kokonut Foundation — Cultivando Fincas Regenerativas" description="Cultivando fincas regenerativas a través de gobernanza comunitaria.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-4xl md:text-6xl font-bold text-strong leading-tight">Cultivando Fincas Regenerativas a Través de Gobernanza Comunitaria</h1>
    <p class="mt-6 text-lg text-muted">Fincas reales. Datos públicos. Gobernanza comunitaria. Valor regenerativo.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/es/projects" class="px-4 py-2 rounded-md bg-primary text-white text-sm font-medium">Explorar Nuestro Trabajo</a>
      <a href="/es/impact" class="px-4 py-2 rounded-md bg-secondary text-strong text-sm font-medium">Ver Impacto</a>
      <a href="https://go.kokonut.foundation/giveth" class="px-4 py-2 text-sm text-primary underline" target="_blank" rel="noopener">Apoya Nuestra Misión</a>
    </div>
  </section>
  <section class="bg-surface-muted py-12">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-sm font-semibold text-muted uppercase tracking-wide mb-8">Prueba de la Fundación</h2>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-6 text-center">
        <div><div class="text-3xl font-bold text-primary">15,725 m²</div><div class="text-sm font-semibold text-strong">Finca Regenerativa</div></div>
        <div><div class="text-3xl font-bold text-primary">96</div><div class="text-sm font-semibold text-strong">Cocoteros</div></div>
        <div><div class="text-3xl font-bold text-primary">110</div><div class="text-sm font-semibold text-strong">Gallinas</div></div>
        <div><div class="text-3xl font-bold text-primary">5</div><div class="text-sm font-semibold text-strong">ODS Abordados</div></div>
        <div><div class="text-3xl font-bold text-primary">3,000+</div><div class="text-sm font-semibold text-strong">Miembros</div></div>
      </div>
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h2 class="text-2xl font-bold text-strong">Qué Hace Kokonut Foundation</h2>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="rounded-lg border border-border bg-surface p-6"><h3 class="font-semibold text-strong">Infraestructura Regenerativa</h3><p class="mt-2 text-sm text-muted">Crear sistemas ecológicos productivos.</p></div>
      <div class="rounded-lg border border-border bg-surface p-6"><h3 class="font-semibold text-strong">Gobernanza Comunitaria</h3><p class="mt-2 text-sm text-muted">Participación transparente y gobernanza.</p></div>
      <div class="rounded-lg border border-border bg-surface p-6"><h3 class="font-semibold text-strong">Verificación Pública</h3><p class="mt-2 text-sm text-muted">Conectar actividad física con datos públicos.</p></div>
    </div>
  </section>
</BaseLayout>
