---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
---
<BaseLayout title="Apoyo — Kokonut Foundation" description="Apoya la Fundación." lang="es">
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Apoyo</h1>
    <p class="mt-4 text-muted">Múltiples formas de contribuir a la Fundación.</p>
    <div class="mt-8">
      <a href="https://go.kokonut.foundation/giveth" class="px-4 py-2 rounded-md bg-primary text-white text-sm font-medium" target="_blank" rel="noopener">Donar vía Giveth</a>
    </div>
  </section>
</BaseLayout>
