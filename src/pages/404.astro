---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/primitives/Button.astro";
---
<BaseLayout title="Not Found — Kokonut Foundation" description="Page not found.">
  <section class="max-w-2xl mx-auto px-4 py-24 text-center">
    <h1 class="text-6xl font-bold text-strong">404</h1>
    <p class="mt-4 text-muted">This page could not be found.</p>
    <div class="mt-8">
      <Button href="/" variant="primary">Go Home</Button>
    </div>
  </section>
</BaseLayout>
