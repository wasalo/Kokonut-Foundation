---
// Server-rendered so the 404 page honours the request locale — a prerendered
// page would always answer in English, and reading request headers on a
// prerendered route is not possible.
export const prerender = false;
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/primitives/Button.astro";
import { getTranslator, localePath, resolveLocale } from "@lib/i18n";

const locale = resolveLocale(Astro);
const t = getTranslator(locale);
---
<BaseLayout title="Not Found — Kokonut Foundation" description="Page not found.">
  <section class="max-w-2xl mx-auto px-4 py-24 text-center">
    <h1 class="text-6xl font-bold text-strong">404</h1>
    <p class="mt-4 text-muted">{t("error.notFound")}</p>
    <div class="mt-8">
      <Button href={localePath(locale, "/")} variant="primary">{t("error.goHome")}</Button>
    </div>
  </section>
</BaseLayout>
