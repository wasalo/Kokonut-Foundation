---
import BaseLayout from "@layouts/BaseLayout.astro";
import ImpactMetric from "@components/domain/ImpactMetric.astro";
import ProjectCard from "@components/domain/ProjectCard.astro";
import Button from "@components/primitives/Button.astro";
import Card from "@components/primitives/Card.astro";
import { getDb } from "@lib/db";
import { projects, metrics } from "@lib/schema";
import { parseJson } from "@lib/utils";

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;

let featuredProjects: any[] = [];
let proofMetrics: any[] = [];
try {
  if (db) {
    featuredProjects = await db.select().from(projects).limit(3);
    proofMetrics = await db.select().from(metrics).limit(6);
  }
} catch {
  // fallback empty
}

const fallbackProjects = [
  { slug: "adelphi", name: "Adelphi Regenerative Farm", summary: "Live regenerative farm in the Dominican Republic.", status: "active", country: "Dominican Republic", sdgs: [2, 13, 15] },
];
const fallbackMetrics = [
  { value: "15,725", unit: "m²", label: "Regenerative Farm", verificationStatus: "verified", source: "Kokonut Intelligence" },
  { value: 96, unit: "", label: "Coconut Trees", verificationStatus: "verified", source: "Kokonut Intelligence" },
  { value: 110, unit: "", label: "Free-Range Hens", verificationStatus: "verified", source: "Kokonut Intelligence" },
  { value: 5, unit: "", label: "SDGs Addressed", verificationStatus: "verified", source: "Kokonut Intelligence" },
  { value: "3,000+", unit: "", label: "Community Members", verificationStatus: "reported", source: "Kokonut Network" },
];

const showProjects = featuredProjects.length ? featuredProjects : fallbackProjects;
const showMetrics = proofMetrics.length
  ? proofMetrics.map((m: any) => ({ value: m.value, unit: m.unit, label: m.name, verificationStatus: m.verificationStatus, source: m.source }))
  : fallbackMetrics;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NonprofitOrganization",
  name: "Kokonut Foundation",
  url: "https://kokonut.foundation",
  description: "Growing Regenerative Farms Through Community Governance",
};
---
<BaseLayout title="Kokonut Foundation — Growing Regenerative Farms Through Community Governance" jsonLd={jsonLd}>
  <section class="max-w-7xl mx-auto px-4 py-16 md:py-24">
    <div class="max-w-3xl">
      <h1 class="text-4xl md:text-6xl font-bold text-strong leading-tight">Growing Regenerative Farms Through Community Governance</h1>
      <p class="mt-6 text-lg text-muted">Real farms. Public data. Community governance. Regenerative value.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/projects" variant="primary">Explore Our Work</Button>
        <Button href="/impact" variant="secondary">View Live Impact</Button>
        <a href="/support" class="px-4 py-2 text-sm text-primary underline">Support Our Mission</a>
      </div>
    </div>
  </section>

  <section class="bg-surface-muted py-12">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-sm font-semibold text-muted uppercase tracking-wide mb-8">Foundation Proof</h2>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-6">
        {showMetrics.map((m: any) => (
          <ImpactMetric value={m.value} unit={m.unit} label={m.label} verificationStatus={m.verificationStatus} source={m.source} />
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-16">
    <h2 class="text-2xl font-bold text-strong">What Kokonut Foundation Does</h2>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <Card>
        <h3 class="font-semibold text-strong">Regenerative Infrastructure</h3>
        <p class="mt-2 text-sm text-muted">Create productive ecological systems rather than short-lived interventions.</p>
      </Card>
      <Card>
        <h3 class="font-semibold text-strong">Community Governance</h3>
        <p class="mt-2 text-sm text-muted">Use transparent participation and governance mechanisms.</p>
      </Card>
      <Card>
        <h3 class="font-semibold text-strong">Public Verification</h3>
        <p class="mt-2 text-sm text-muted">Connect physical activity to public evidence and data.</p>
      </Card>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-16">
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-bold text-strong">How It Works</h2>
      <a href="/how-it-works" class="text-sm text-primary">Learn more →</a>
    </div>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-4 gap-4">
      {["Fund", "Grow", "Verify", "Repeat"].map((s, i) => (
        <div class="rounded-lg border border-border p-6 text-center">
          <div class="text-2xl font-bold text-primary">{i + 1}</div>
          <div class="mt-2 font-semibold text-strong">{s}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-16">
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-bold text-strong">Projects</h2>
      <a href="/projects" class="text-sm text-primary">View all →</a>
    </div>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      {showProjects.map((p: any) => (
        <ProjectCard slug={p.slug} name={p.name} summary={p.summary} status={p.status} country={p.country} sdgs={parseJson(p.sdgs ?? "[]", [])} />
      ))}
    </div>
  </section>
</BaseLayout>
