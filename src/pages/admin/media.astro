---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getDb } from "@lib/db";
import { evidence } from "@lib/schema";

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(evidence); } catch {}
const media = list.filter((e: any) => e.objectKey);
---
<BaseLayout title="Media — Admin" description="Admin media.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Media (Admin)</h1>
    <p class="mt-2 text-muted text-sm">{media.length} files in R2.</p>
    <ul class="mt-6 space-y-2">
      {media.map((m: any) => <li class="text-sm font-mono text-xs">{m.objectKey} — {m.title}</li>)}
    </ul>
  </section>
</BaseLayout>
