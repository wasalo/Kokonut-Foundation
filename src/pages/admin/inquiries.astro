---
import AdminLayout from "@components/admin/AdminLayout.astro";
import { getDb } from "@lib/db";
import { inquiries } from "@lib/schema";
import { desc } from "drizzle-orm";
import { formatDate } from "@lib/utils";
import { adminPageGuard } from "@lib/admin-page";
const denied = adminPageGuard(Astro, "inquiries.read");
if (denied) return denied;

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(inquiries).orderBy(desc(inquiries.createdAt)); } catch {}
---
<AdminLayout title="Inquiries — Admin" description="Admin inquiries.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Inquiries</h1>
    <div class="mt-6 space-y-3">
      {list.length === 0 && <p class="text-muted">No inquiries yet.</p>}
      {list.map((i: any) => (
        <div class="rounded-lg border border-border p-4">
          <div class="flex justify-between text-sm">
            <span class="font-semibold">{i.name} &lt;{i.email}&gt;</span>
            <span class="text-muted">{formatDate(i.createdAt)}</span>
          </div>
          <p class="mt-1 text-sm text-muted">{i.type} · {i.status}</p>
          <p class="mt-2 text-sm">{i.message}</p>
        </div>
      ))}
    </div>
  </section>
</AdminLayout>
