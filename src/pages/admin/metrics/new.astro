---
import AdminLayout from "@components/admin/AdminLayout.astro";
import { adminPageGuard } from "@lib/admin-page";
const denied = adminPageGuard(Astro, "metrics.create");
if (denied) return denied;
---
<AdminLayout title="New Metric — Admin" description="Create metric.">
  <section class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">New Metric</h1>
    <form id="f" class="mt-6 space-y-4">
      <input name="name" placeholder="Name" required class="w-full rounded border border-border px-3 py-2" />
      <input name="slug" placeholder="Slug (optional)" class="w-full rounded border border-border px-3 py-2" />
      <textarea name="description" placeholder="Description" rows="3" class="w-full rounded border border-border px-3 py-2"></textarea>
      <select name="category" class="w-full rounded border border-border px-3 py-2">
        <option>Ecology</option><option>Agriculture</option><option>Community</option><option>Economic</option><option>Public Goods</option>
      </select>
      <input name="value" type="number" step="any" placeholder="Value" required class="w-full rounded border border-border px-3 py-2" />
      <input name="unit" placeholder="Unit" class="w-full rounded border border-border px-3 py-2" />
      <input name="projectId" placeholder="Project ID (optional)" class="w-full rounded border border-border px-3 py-2" />
      <select name="verificationStatus" class="w-full rounded border border-border px-3 py-2">
        <option value="reported">Reported</option><option value="reviewed">Reviewed</option><option value="verified">Verified</option><option value="attested">Attested</option>
      </select>
      <button type="submit" class="px-4 py-2 rounded bg-primary text-on-primary text-sm">Create</button>
    </form>
    <p id="r" class="mt-4 text-sm"></p>
  </section>
  <script>
    document.getElementById("f")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      const res = await fetch("/api/admin/metrics", { method: "POST", body: fd });
      const j = await res.json();
      const el = document.getElementById("r");
      if (el) el.textContent = res.ok ? `Created: ${j.data.slug}` : (j.error ?? "Error");
    });
  </script>
</AdminLayout>
