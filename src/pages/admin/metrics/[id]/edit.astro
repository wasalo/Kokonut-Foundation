---
import AdminLayout from "@components/admin/AdminLayout.astro";
import EntityForm from "@components/admin/EntityForm.astro";
import { getDb } from "@lib/db";
import { metrics } from "@lib/schema";
import { eq } from "drizzle-orm";
import { adminPageGuard } from "@lib/admin-page";
const denied = adminPageGuard(Astro, "metrics.update");
if (denied) return denied;

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
const id = Astro.params.id as string;
let record: Record<string, unknown> = {};
try { if (db) record = (await db.select().from(metrics).where(eq(metrics.id, id)).get()) ?? {}; } catch {}
---
<AdminLayout title="Edit Metric — Admin" description="Admin metric edit.">
  <section class="max-w-2xl mx-auto px-4 py-16">
    <a href="/admin/metrics" class="text-sm text-primary">← Metrics</a>
    <h1 class="mt-2 text-3xl font-bold text-strong">Edit Metric</h1>
    <p class="mt-2 text-sm text-muted">{String(record.name ?? id)}</p>
    <EntityForm
      endpoint="/api/admin/metrics"
      id={id}
      submitLabel="Save changes"
      record={record}
      fields={[
        { name: "name", label: "Name", required: true },
        { name: "description", label: "Description", type: "textarea" },
        { name: "category", label: "Category" },
        { name: "value", label: "Value", type: "number" },
        { name: "unit", label: "Unit" },
        { name: "methodology", label: "Methodology" },
        { name: "source", label: "Source" },
        { name: "verificationStatus", label: "Verification", type: "select", options: [
          { value: "reported", label: "reported" },
          { value: "reviewed", label: "reviewed" },
          { value: "verified", label: "verified" },
          { value: "attested", label: "attested" },
        ] },
      ]}
    />
  </section>
</AdminLayout>
