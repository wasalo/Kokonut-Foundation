---
import AdminLayout from "@components/admin/AdminLayout.astro";
import { getDb } from "@lib/db";
import { partners } from "@lib/schema";
import DeleteButton from "@components/admin/DeleteButton.astro";
import { adminPageGuard } from "@lib/admin-page";
import Can from "@components/admin/Can.astro";
const denied = adminPageGuard(Astro, "partners.read");
if (denied) return denied;

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(partners); } catch {}
---
<AdminLayout title="Partners — Admin" description="Admin partners.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Partners (Admin)</h1>
    <p class="mt-2 text-muted text-sm">{list.length} records.</p>
    <ul class="mt-6 space-y-2">
      {list.map((p: any) => (
        <li class="text-sm flex flex-wrap items-center gap-3">
          <span>{p.name} — {p.type} ({p.country})</span>
          <Can capability="partners.update"><a href={`/admin/partners/${p.id}/edit`} class="text-xs text-primary underline">Edit</a></Can>
          <Can capability="partners.delete"><DeleteButton endpoint="/api/admin/partners" id={p.id} capability="partners.delete" /></Can>
        </li>
      ))}
    </ul>
  </section>
</AdminLayout>
