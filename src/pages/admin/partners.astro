---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getDb } from "@lib/db";
import { partners } from "@lib/schema";
import DeleteButton from "@components/admin/DeleteButton.astro";

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(partners); } catch {}
---
<BaseLayout title="Partners — Admin" description="Admin partners.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Partners (Admin)</h1>
    <p class="mt-2 text-muted text-sm">{list.length} records.</p>
    <ul class="mt-6 space-y-2">
      {list.map((p: any) => <li class="text-sm flex items-center gap-3">{p.name} — {p.type} ({p.country})<DeleteButton endpoint="/api/admin/partners" id={p.id} /></li>)}
    </ul>
  </section>
</BaseLayout>
