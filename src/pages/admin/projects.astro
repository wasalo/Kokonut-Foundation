---
import BaseLayout from "@layouts/BaseLayout.astro";
import DeleteButton from "@components/admin/DeleteButton.astro";
import { getDb } from "@lib/db";
import { projects } from "@lib/schema";

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(projects); } catch {}
---
<BaseLayout title="Projects — Admin" description="Admin projects.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Projects (Admin)</h1>
    <a href="/admin/projects/new" class="mt-2 inline-block text-sm text-primary">+ New Project</a>
    <p class="mt-2 text-muted text-sm">Manage via D1. {list.length} records.</p>
    <ul class="mt-6 space-y-2">
      {list.map((p: any) => (
        <li class="text-sm flex items-center gap-3">
          <span>{p.name} — <span class="px-2 py-0.5 rounded text-xs bg-surface-muted">{p.status}</span></span>
          <a href={`/admin/projects/${p.id}/edit`} class="text-xs text-primary underline">Edit</a>
          <DeleteButton endpoint="/api/admin/projects" id={p.id} />
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
