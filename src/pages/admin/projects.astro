---
import AdminLayout from "@components/admin/AdminLayout.astro";
import DeleteButton from "@components/admin/DeleteButton.astro";
import { getDb } from "@lib/db";
import { projects } from "@lib/schema";
import { adminPageGuard } from "@lib/admin-page";
import Can from "@components/admin/Can.astro";
import StatusSelect from "@components/admin/StatusSelect.astro";
const denied = adminPageGuard(Astro, "projects.read");
if (denied) return denied;

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(projects); } catch {}
---
<AdminLayout title="Projects — Admin" description="Admin projects.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Projects (Admin)</h1>
    <Can capability="projects.create"><a href="/admin/projects/new" class="mt-2 inline-block text-sm text-primary">+ New Project</a></Can>
    <p class="mt-2 text-muted text-sm">Manage via D1. {list.length} records.</p>
    <ul class="mt-6 space-y-2">
      {list.map((p: any) => (
        <li class="text-sm flex flex-wrap items-center gap-3">
          <span>{p.name} — <span class="px-2 py-0.5 rounded text-xs bg-surface-muted">{p.status}</span></span>
          <Can capability="projects.update"><a href={`/admin/projects/${p.id}/edit`} class="text-xs text-primary underline">Edit</a></Can>
          <StatusSelect entity="project" id={p.id} capability="projects.publish" />
          <Can capability="projects.delete"><DeleteButton endpoint="/api/admin/projects" id={p.id} capability="projects.delete" /></Can>
        </li>
      ))}
    </ul>
  </section>
</AdminLayout>
