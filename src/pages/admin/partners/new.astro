---
import AdminLayout from "@components/admin/AdminLayout.astro";
import { adminPageGuard } from "@lib/admin-page";
const denied = adminPageGuard(Astro, "partners.create");
if (denied) return denied;
---
<AdminLayout title="New Partner — Admin" description="Create partner.">
  <section class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">New Partner</h1>
    <form id="f" class="mt-6 space-y-4">
      <input name="name" placeholder="Name" required class="w-full rounded border border-border px-3 py-2" />
      <input name="type" placeholder="Type (NGO, Foundation, Research, …)" value="Partner" class="w-full rounded border border-border px-3 py-2" />
      <input name="country" placeholder="Country" class="w-full rounded border border-border px-3 py-2" />
      <input name="website" placeholder="Website URL" class="w-full rounded border border-border px-3 py-2" />
      <textarea name="description" placeholder="Description" rows="3" class="w-full rounded border border-border px-3 py-2"></textarea>
      <button type="submit" class="px-4 py-2 rounded bg-primary text-on-primary text-sm">Create</button>
    </form>
    <p id="r" class="mt-4 text-sm"></p>
  </section>
  <script>
    document.getElementById("f")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      const res = await fetch("/api/admin/partners", { method: "POST", body: fd });
      const j = await res.json();
      const el = document.getElementById("r");
      if (el) el.textContent = res.ok ? `Created: ${j.data.slug}` : (j.error ?? "Error");
    });
  </script>
</AdminLayout>
