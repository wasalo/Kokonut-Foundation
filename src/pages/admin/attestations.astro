---
import AdminLayout from "@components/admin/AdminLayout.astro";
import Can from "@components/admin/Can.astro";
import BulkBar from "@components/admin/BulkBar.astro";
import DeleteButton from "@components/admin/DeleteButton.astro";
import { adminPageGuard } from "@lib/admin-page";
const denied = adminPageGuard(Astro, "attestations.read");
if (denied) return denied;

import { getDb } from "@lib/db";
import { attestations } from "@lib/schema";

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(attestations); } catch {}
---
<AdminLayout title="Attestations — Admin" description="Admin attestations.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Attestations (Admin)</h1>
    <Can capability="attestations.create"><a href="/admin/attestations/new" class="mt-2 inline-block text-sm text-primary">+ New Attestation</a></Can>
    <p class="mt-2 text-muted text-sm">{list.length} records.</p>
    <ul class="mt-6 space-y-2">
      {list.map((a: any) => (
        <li class="text-sm flex flex-wrap items-center gap-3">
          <input type="checkbox" data-bulk-entity="attestations" value={a.id} aria-label={`Select ${a.title}`} />
          <span>{a.title} — {a.source} · {a.verificationStatus}</span>
          <Can capability="attestations.update"><a href={`/admin/attestations/${a.id}/edit`} class="text-xs text-primary underline">Edit</a></Can>
          <Can capability="attestations.delete"><DeleteButton endpoint="/api/admin/attestations" id={a.id} capability="attestations.delete" /></Can>
        </li>
      ))}
    </ul>
    <BulkBar entity="attestations" />
  </section>
</AdminLayout>
