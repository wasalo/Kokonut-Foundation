---
import BaseLayout from "@layouts/BaseLayout.astro";
---
<BaseLayout title="New Farm — Admin" description="Create farm.">
  <section class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">New Farm</h1>
    <form id="f" class="mt-6 space-y-4">
      <input name="name" placeholder="Name" required class="w-full rounded border border-border px-3 py-2" />
      <input name="country" placeholder="Country" required class="w-full rounded border border-border px-3 py-2" />
      <input name="region" placeholder="Region" class="w-full rounded border border-border px-3 py-2" />
      <input name="latitude" type="number" step="any" placeholder="Latitude" class="w-full rounded border border-border px-3 py-2" />
      <input name="longitude" type="number" step="any" placeholder="Longitude" class="w-full rounded border border-border px-3 py-2" />
      <input name="areaM2" type="number" step="any" placeholder="Total area (m²)" class="w-full rounded border border-border px-3 py-2" />
      <input name="agriculturalAreaM2" type="number" step="any" placeholder="Agricultural area (m²)" class="w-full rounded border border-border px-3 py-2" />
      <input name="founders" placeholder="Founders" class="w-full rounded border border-border px-3 py-2" />
      <input name="jobs" type="number" placeholder="Jobs" class="w-full rounded border border-border px-3 py-2" />
      <input name="fundingRef" placeholder="Funding ref" class="w-full rounded border border-border px-3 py-2" />
      <input name="publicGoodsAllocation" type="number" step="any" placeholder="Public goods allocation %" class="w-full rounded border border-border px-3 py-2" />
      <textarea name="description" placeholder="Description" rows="3" class="w-full rounded border border-border px-3 py-2"></textarea>
      <button type="submit" class="px-4 py-2 rounded bg-primary text-white text-sm">Create</button>
    </form>
    <p id="r" class="mt-4 text-sm"></p>
  </section>
  <script>
    document.getElementById("f")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      const res = await fetch("/api/admin/farms", { method: "POST", body: fd });
      const j = await res.json();
      const el = document.getElementById("r");
      if (el) el.textContent = res.ok ? `Created: ${j.data.slug}` : (j.error ?? "Error");
    });
  </script>
</BaseLayout>
