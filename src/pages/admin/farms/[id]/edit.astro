---
import BaseLayout from "@layouts/BaseLayout.astro";
import EntityForm from "@components/admin/EntityForm.astro";
import { getDb } from "@lib/db";
import { farms } from "@lib/schema";
import { eq } from "drizzle-orm";

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
const id = Astro.params.id as string;
let record: Record<string, unknown> = {};
try { if (db) record = (await db.select().from(farms).where(eq(farms.id, id)).get()) ?? {}; } catch {}
---
<BaseLayout title="Edit Farm — Admin" description="Admin farm edit.">
  <section class="max-w-2xl mx-auto px-4 py-16">
    <a href="/admin/farms" class="text-sm text-primary">← Farms</a>
    <h1 class="mt-2 text-3xl font-bold text-strong">Edit Farm</h1>
    <p class="mt-2 text-sm text-muted">{String(record.name ?? id)}</p>
    <EntityForm
      endpoint="/api/admin/farms"
      id={id}
      submitLabel="Save changes"
      record={record}
      fields={[
        { name: "name", label: "Name", required: true },
        { name: "description", label: "Description", type: "textarea" },
        { name: "country", label: "Country" },
        { name: "region", label: "Region" },
        { name: "latitude", label: "Latitude", type: "number" },
        { name: "longitude", label: "Longitude", type: "number" },
        { name: "areaM2", label: "Area (m²)", type: "number" },
        { name: "agriculturalAreaM2", label: "Agricultural area (m²)", type: "number" },
        { name: "founders", label: "Founders" },
        { name: "jobs", label: "Jobs", type: "number" },
        { name: "frameworkPhase", label: "Framework phase" },
        { name: "fundingRef", label: "Funding reference" },
        { name: "publicGoodsAllocation", label: "Public goods allocation (%)", type: "number" },
        { name: "status", label: "Status", type: "select", options: [
          { value: "active", label: "active" },
          { value: "planned", label: "planned" },
          { value: "paused", label: "paused" },
        ] },
      ]}
    />
  </section>
</BaseLayout>
