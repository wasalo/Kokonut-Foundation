---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/primitives/Card.astro";

const env = (Astro.locals as any).runtime?.env ?? {};
const kv = env.CONFIG as KVNamespace | undefined;
const today = new Date().toISOString().slice(0, 10);
const weekAgo = new Date(Date.now() - 7 * 86400000).toISOString().slice(0, 10);

const events = [
  ["home_view", "Home views"],
  ["project_view", "Project detail views"],
  ["impact_view", "Impact explorer views"],
  ["farms_view", "Farm explorer views"],
  ["transparency_view", "Transparency portal views"],
  ["treasury_view", "Treasury views"],
  ["attestations_view", "Attestation views"],
  ["reports_view", "Report views"],
  ["evidence_view", "Evidence browser views"],
  ["resources_view", "Resource views"],
  ["partners_view", "Partner views"],
  ["about_view", "About views"],
  ["support_view", "Support views"],
  ["contact_view", "Contact views"],
];

let rows: { label: string; today: number; week: number }[] = [];
try {
  if (kv) {
    rows = await Promise.all(
      events.map(async ([event, label]) => {
        const [t, w] = await Promise.all([
          kv.get(`ev:${event}:${today}`).then((v) => Number(v ?? 0)),
          kv.get(`ev:${event}:${weekAgo}`).then((v) => Number(v ?? 0)),
        ]);
        return { label, today: t, week: w };
      }),
    );
  }
} catch {}

const totals = rows.reduce((a, r) => ({ today: a.today + r.today, week: a.week + r.week }), { today: 0, week: 0 });
---
<BaseLayout title="Analytics — Admin" description="Admin analytics.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Analytics</h1>
    <p class="mt-2 text-muted text-sm">Product events for {today} (and {weekAgo} for comparison).</p>
    <div class="mt-6 grid grid-cols-2 gap-4">
      <Card>
        <p class="text-xs text-muted">Events today</p>
        <p class="text-3xl font-bold text-primary">{totals.today}</p>
      </Card>
      <Card>
        <p class="text-xs text-muted">Events 7 days ago</p>
        <p class="text-3xl font-bold text-strong">{totals.week}</p>
      </Card>
    </div>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-sm border border-border">
        <thead class="bg-surface-muted">
          <tr>
            <th class="text-left p-3 border-b border-border">Event</th>
            <th class="text-left p-3 border-b border-border">Today</th>
            <th class="text-left p-3 border-b border-border">7 days ago</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td class="p-3 border-b border-border">{r.label}</td>
              <td class="p-3 border-b border-border">{r.today}</td>
              <td class="p-3 border-b border-border">{r.week}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
