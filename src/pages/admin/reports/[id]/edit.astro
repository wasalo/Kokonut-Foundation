---
import AdminLayout from "@components/admin/AdminLayout.astro";
import EntityForm from "@components/admin/EntityForm.astro";
import { adminPageGuard } from "@lib/admin-page";
const denied = adminPageGuard(Astro, "reports.update");
if (denied) return denied;

import { getDb } from "@lib/db";
import { reports } from "@lib/schema";
import { eq } from "drizzle-orm";

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
const id = Astro.params.id as string;
let record: Record<string, unknown> = {};
try { if (db) record = (await db.select().from(reports).where(eq(reports.id, id)).get()) ?? {}; } catch {}
---
<AdminLayout title="Edit Report — Admin" description="Admin Report edit.">
  <section class="max-w-2xl mx-auto px-4 py-16">
    <a href="/admin/reports" class="text-sm text-primary">← Reports</a>
    <h1 class="mt-2 text-3xl font-bold text-strong">Edit Report</h1>
    <p class="mt-2 text-sm text-muted">{String(record.title ?? id)}</p>
    <EntityForm
      endpoint="/api/admin/reports"
      id={id}
      submitLabel="Save changes"
      record={record}
      fields={[
        { name: "title", label: "Title", required: true },
        { name: "slug", label: "Slug" },
        { name: "summary", label: "Summary", type: "textarea" },
        { name: "reportType", label: "Type" },
        { name: "projectId", label: "Project ID" },
        { name: "periodStart", label: "Period start" },
        { name: "periodEnd", label: "Period end" },
        { name: "publishedAt", label: "Published at" },
        { name: "documentKey", label: "Document key" },
        { name: "authors", label: "Authors (comma separated)" },
        { name: "visibility", label: "Visibility", type: "select", options: [
            { value: "public", label: "public" },
            { value: "private", label: "private" },
            { value: "consented", label: "consented" },
          ] },
        { name: "status", label: "Status", type: "select", options: [
            { value: "draft", label: "draft" },
            { value: "submitted", label: "submitted" },
            { value: "verified", label: "verified" },
            { value: "published", label: "published" },
            { value: "rejected", label: "rejected" },
            { value: "archived", label: "archived" },
          ] },
      ]}
    />
  </section>
</AdminLayout>
