---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getDb } from "@lib/db";
import { measurements } from "@lib/schema";

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(measurements); } catch {}
---
<BaseLayout title="Measurements — Admin" description="Admin measurements.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Measurements (Admin)</h1>
    <p class="mt-2 text-muted text-sm">{list.length} records.</p>
    <ul class="mt-6 space-y-2">
      {list.map((m: any) => <li class="text-sm">{m.metricId}: {m.value} ({m.observedAt})</li>)}
    </ul>
  </section>
</BaseLayout>
