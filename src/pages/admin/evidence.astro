---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getDb } from "@lib/db";
import { evidence } from "@lib/schema";

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(evidence); } catch {}
---
<BaseLayout title="Evidence — Admin" description="Admin evidence.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Evidence (Admin)</h1>
    <a href="/admin/evidence/new" class="mt-2 inline-block text-sm text-primary">+ New Evidence</a>
    <p class="mt-2 text-muted text-sm">{list.length} records.</p>
    <ul class="mt-6 space-y-2">
      {list.map((e: any) => (
        <li class="text-sm flex items-center gap-2">
          {e.title} — <span class="px-2 py-0.5 rounded text-xs bg-surface-muted">{e.status ?? "published"}</span>
          <select data-entity="evidence" data-id={e.id} class="status-sel text-xs border border-border rounded px-1">
            <option value="">change…</option>
            <option value="draft">draft</option>
            <option value="review">review</option>
            <option value="approved">approved</option>
            <option value="published">published</option>
            <option value="archived">archived</option>
          </select>
        </li>
      ))}
    </ul>
    <script>
      document.querySelectorAll(".status-sel").forEach((sel) => {
        sel.addEventListener("change", async (e) => {
          const t = e.target as HTMLSelectElement;
          const v = t.value;
          if (!v) return;
          await fetch("/api/admin/status", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ entityType: t.dataset.entity, entityId: t.dataset.id, status: v }) });
          location.reload();
        });
      });
    </script>
  </section>
</BaseLayout>
