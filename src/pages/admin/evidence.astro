---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getDb } from "@lib/db";
import { evidence } from "@lib/schema";

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(evidence); } catch {}
---
<BaseLayout title="Evidence — Admin" description="Admin evidence.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Evidence (Admin)</h1>
    <a href="/admin/evidence/new" class="mt-2 inline-block text-sm text-primary">+ New Evidence</a>
    <p class="mt-2 text-muted text-sm">{list.length} records.</p>
    <ul class="mt-6 space-y-2">
      {list.map((e: any) => <li class="text-sm">{e.title} — {e.type} ({e.visibility})</li>)}
    </ul>
  </section>
</BaseLayout>
