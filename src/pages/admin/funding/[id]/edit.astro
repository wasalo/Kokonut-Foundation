---
import AdminLayout from "@components/admin/AdminLayout.astro";
import EntityForm from "@components/admin/EntityForm.astro";
import { adminPageGuard } from "@lib/admin-page";
const denied = adminPageGuard(Astro, "funding.update");
if (denied) return denied;

import { getDb } from "@lib/db";
import { fundingEvents } from "@lib/schema";
import { eq } from "drizzle-orm";

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
const id = Astro.params.id as string;
let record: Record<string, unknown> = {};
try { if (db) record = (await db.select().from(fundingEvents).where(eq(fundingEvents.id, id)).get()) ?? {}; } catch {}
---
<AdminLayout title="Edit Funding Event — Admin" description="Admin funding event edit.">
  <section class="max-w-2xl mx-auto px-4 py-16">
    <a href="/admin/funding" class="text-sm text-primary">← Funding</a>
    <h1 class="mt-2 text-3xl font-bold text-strong">Edit Funding Event</h1>
    <p class="mt-2 text-sm text-muted">{String(record.title ?? id)}</p>
    <EntityForm
      endpoint="/api/admin/funding"
      id={id}
      submitLabel="Save changes"
      record={record}
      fields={[
        { name: "title", label: "Title", required: true },
        { name: "amount", label: "Amount", type: "number" },
        { name: "currency", label: "Currency" },
        { name: "funder", label: "Funder" },
        { name: "projectId", label: "Project ID" },
        { name: "occurredAt", label: "Occurred at" },
        { name: "category", label: "Category" },
        { name: "externalUrl", label: "External URL" },
      ]}
    />
  </section>
</AdminLayout>
