---
import AdminLayout from "@components/admin/AdminLayout.astro";
import EntityForm from "@components/admin/EntityForm.astro";
import { adminPageGuard } from "@lib/admin-page";
const denied = adminPageGuard(Astro, "redirects.update");
if (denied) return denied;

import { getDb } from "@lib/db";
import { redirects } from "@lib/schema";
import { eq } from "drizzle-orm";

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
const id = Astro.params.id as string;
let record: Record<string, unknown> = {};
try { if (db) record = (await db.select().from(redirects).where(eq(redirects.id, id)).get()) ?? {}; } catch {}
---
<AdminLayout title="Edit Redirect — Admin" description="Admin Redirect edit.">
  <section class="max-w-2xl mx-auto px-4 py-16">
    <a href="/admin/redirects" class="text-sm text-primary">← Redirects</a>
    <h1 class="mt-2 text-3xl font-bold text-strong">Edit Redirect</h1>
    <p class="mt-2 text-sm text-muted">{String(record.fromPath ?? id)}</p>
    <EntityForm
      endpoint="/api/admin/redirects"
      id={id}
      submitLabel="Save changes"
      record={record}
      fields={[
        { name: "fromPath", label: "From path", required: true },
        { name: "toPath", label: "To path", required: true },
        { name: "statusCode", label: "Status code", type: "number" },
      ]}
    />
  </section>
</AdminLayout>
