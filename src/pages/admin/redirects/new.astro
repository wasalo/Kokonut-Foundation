---
import BaseLayout from "@layouts/BaseLayout.astro";
---
<BaseLayout title="New Redirect — Admin" description="Create redirect.">
  <section class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">New Redirect</h1>
    <form id="f" class="mt-6 space-y-4">
      <input name="fromPath" placeholder="From path (e.g. /old-page)" required class="w-full rounded border border-border px-3 py-2" />
      <input name="toPath" placeholder="To path (e.g. /new-page)" required class="w-full rounded border border-border px-3 py-2" />
      <select name="statusCode" class="w-full rounded border border-border px-3 py-2">
        <option value="301">301 Permanent</option>
        <option value="302">302 Temporary</option>
      </select>
      <button type="submit" class="px-4 py-2 rounded bg-primary text-on-primary text-sm">Create</button>
    </form>
    <p id="r" class="mt-4 text-sm"></p>
  </section>
  <script>
    document.getElementById("f")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      const res = await fetch("/api/admin/redirects", { method: "POST", body: fd });
      const j = await res.json();
      const el = document.getElementById("r");
      if (el) el.textContent = res.ok ? `Created: ${j.data.id}` : (j.error ?? "Error");
    });
  </script>
</BaseLayout>
