---
import AdminLayout from "@components/admin/AdminLayout.astro";
import { getDb } from "@lib/db";
import { resources } from "@lib/schema";
import DeleteButton from "@components/admin/DeleteButton.astro";
import { adminPageGuard } from "@lib/admin-page";
import Can from "@components/admin/Can.astro";
import StatusSelect from "@components/admin/StatusSelect.astro";
import BulkBar from "@components/admin/BulkBar.astro";
const denied = adminPageGuard(Astro, "resources.read");
if (denied) return denied;

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(resources); } catch {}
---
<AdminLayout title="Resources — Admin" description="Admin resources.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Resources (Admin)</h1>
    <Can capability="resources.create"><a href="/admin/resources/new" class="mt-2 inline-block text-sm text-primary">+ New Resource</a></Can>
    <p class="mt-2 text-muted text-sm">{list.length} records.</p>
    <ul class="mt-6 space-y-2">
      {list.map((r: any) => (
        <li class="text-sm flex flex-wrap items-center gap-3">
          <input type="checkbox" data-bulk-entity="resources" value={r.id} aria-label="Select record" />
          <span>{r.title} — {r.resourceType}</span>
          <Can capability="resources.update"><a href={`/admin/resources/${r.id}/edit`} class="text-xs text-primary underline">Edit</a></Can>
          <StatusSelect entity="resource" id={r.id} capability="resources.update" publishCapability="resources.publish" />
          <Can capability="resources.delete"><DeleteButton endpoint="/api/admin/resources" id={r.id} capability="resources.delete" /></Can>
        </li>
      ))}
    </ul>
        <BulkBar entity="resources" publishCapability="resources.publish" deleteCapability="resources.delete" />
  </section>
</AdminLayout>
