---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getDb } from "@lib/db";
import { teamMembers } from "@lib/schema";
import DeleteButton from "@components/admin/DeleteButton.astro";

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(teamMembers); } catch {}
---
<BaseLayout title="Team — Admin" description="Admin team.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Team (Admin)</h1>
    <a href="/admin/team/new" class="mt-2 inline-block text-sm text-primary">+ New Team Member</a>
    <p class="mt-2 text-muted text-sm">{list.length} records.</p>
    <ul class="mt-6 space-y-2">
      {list.map((t: any) => <li class="text-sm flex items-center gap-3">{t.name} — {t.role}<DeleteButton endpoint="/api/admin/team" id={t.id} /></li>)}
    </ul>
  </section>
</BaseLayout>
