---
import AdminLayout from "@components/admin/AdminLayout.astro";
import { getDb } from "@lib/db";
import { teamMembers } from "@lib/schema";
import DeleteButton from "@components/admin/DeleteButton.astro";
import { adminPageGuard } from "@lib/admin-page";
import Can from "@components/admin/Can.astro";
const denied = adminPageGuard(Astro, "team.read");
if (denied) return denied;

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(teamMembers); } catch {}
---
<AdminLayout title="Team — Admin" description="Admin team.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Team (Admin)</h1>
    <Can capability="team.create"><a href="/admin/team/new" class="mt-2 inline-block text-sm text-primary">+ New Team Member</a></Can>
    <p class="mt-2 text-muted text-sm">{list.length} records.</p>
    <ul class="mt-6 space-y-2">
      {list.map((t: any) => (
        <li class="text-sm flex flex-wrap items-center gap-3">
          <span>{t.name} — {t.role}</span>
          <Can capability="team.update"><a href={`/admin/team/${t.id}/edit`} class="text-xs text-primary underline">Edit</a></Can>
          <Can capability="team.delete"><DeleteButton endpoint="/api/admin/team" id={t.id} capability="team.delete" /></Can>
        </li>
      ))}
    </ul>
  </section>
</AdminLayout>
