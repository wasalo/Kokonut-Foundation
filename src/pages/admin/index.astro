---
import AdminLayout from "@components/admin/AdminLayout.astro";
import Card from "@components/primitives/Card.astro";
import { adminPageGuard } from "@lib/admin-page";
const denied = adminPageGuard(Astro, "access.admin");
if (denied) return denied;
const links = [
  { href: "/admin/projects", label: "Projects" },
  { href: "/admin/metrics", label: "Metrics" },
  { href: "/admin/inquiries", label: "Inquiries" },
  { href: "/admin/evidence", label: "Evidence" },
  { href: "/admin/farms", label: "Farms" },
  { href: "/admin/reports", label: "Reports" },
  { href: "/admin/partners", label: "Partners" },
  { href: "/admin/team", label: "Team" },
  { href: "/admin/resources", label: "Resources" },
  { href: "/admin/milestones", label: "Milestones" },
  { href: "/admin/measurements", label: "Measurements" },
  { href: "/admin/redirects", label: "Redirects" },
  { href: "/admin/media", label: "Media" },
  { href: "/admin/sync", label: "KI Sync" },
  { href: "/transparency/treasury", label: "Treasury" },
  { href: "/transparency/attestations", label: "Attestations" },
  { href: "/explorer/graph", label: "Graph" },
  { href: "/admin/audit", label: "Audit Log" },
  { href: "/admin/analytics", label: "Analytics" },
];
---
<AdminLayout title="Admin — Kokonut Foundation" description="Admin dashboard.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Admin Dashboard</h1>
    <p class="mt-2 text-muted">Protected by Cloudflare Access.</p>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      {links.map((l) => (
        <a href={l.href}><Card><h2 class="font-semibold text-strong">{l.label}</h2></Card></a>
      ))}
    </div>
  </section>
</AdminLayout>
