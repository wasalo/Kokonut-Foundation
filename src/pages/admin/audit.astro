---
import AdminLayout from "@components/admin/AdminLayout.astro";
import { getDb } from "@lib/db";
import { auditLog } from "@lib/schema";
import { desc } from "drizzle-orm";
import { formatDate } from "@lib/utils";
import { adminPageGuard } from "@lib/admin-page";
const denied = adminPageGuard(Astro, "access.audit");
if (denied) return denied;

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(auditLog).orderBy(desc(auditLog.timestamp)); } catch {}
---
<AdminLayout title="Audit Log — Admin" description="Admin audit.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Audit Log</h1>
    <p class="mt-2 text-muted text-sm">{list.length} entries.</p>
    <div class="mt-6 space-y-2">
      {list.map((a: any) => (
        <div class="rounded border border-border p-3 text-sm">
          <div class="flex justify-between">
            <span class="font-semibold">{a.action}</span>
            <span class="text-muted text-xs">{formatDate(a.timestamp)}</span>
          </div>
          <p class="text-xs text-muted">{a.entityType} · {a.entityId} · actor: {a.actor}</p>
        </div>
      ))}
    </div>
  </section>
</AdminLayout>
