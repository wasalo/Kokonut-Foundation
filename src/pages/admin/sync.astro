---
import AdminLayout from "@components/admin/AdminLayout.astro";
import { getDb } from "@lib/db";
import { syncJobs } from "@lib/schema";
import { adminPageGuard } from "@lib/admin-page";
const denied = adminPageGuard(Astro, "access.sync");
if (denied) return denied;

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(syncJobs); } catch {}
list = [...list].sort((a: any, b: any) => (b.startedAt ?? "").localeCompare(a.startedAt ?? ""));
---
<AdminLayout title="Sync — Admin" description="KI sync.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Kokonut Intelligence Sync</h1>
    <button id="sync-btn" class="mt-4 px-4 py-2 rounded-md bg-primary text-on-primary text-sm">Run Sync Now</button>
    <p id="sync-result" class="mt-3 text-sm text-muted"></p>
    <h2 class="mt-8 text-xl font-semibold text-strong">Recent Runs</h2>
    <ul class="mt-4 space-y-2">
      {list.map((s: any) => (
        <li class="text-sm">{s.startedAt} — {s.status}: {s.details}</li>
      ))}
    </ul>
  </section>
  <script>
    document.getElementById("sync-btn")?.addEventListener("click", async () => {
      const res = await fetch("/api/admin/sync/ki", { method: "POST" });
      const json = await res.json();
      const el = document.getElementById("sync-result");
      if (el) el.textContent = res.ok ? `Sync ${json.data.status}: ${json.data.details}` : (json.error ?? "Error");
    });
  </script>
</AdminLayout>
