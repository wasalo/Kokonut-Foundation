---
import BaseLayout from "@layouts/BaseLayout.astro";
---
<BaseLayout title="New Measurement — Admin" description="Create measurement.">
  <section class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">New Measurement</h1>
    <form id="f" class="mt-6 space-y-4">
      <input name="metricId" placeholder="Metric ID" required class="w-full rounded border border-border px-3 py-2" />
      <input name="projectId" placeholder="Project ID (optional)" class="w-full rounded border border-border px-3 py-2" />
      <input name="value" type="number" step="any" placeholder="Value" required class="w-full rounded border border-border px-3 py-2" />
      <input name="observedAt" type="date" class="w-full rounded border border-border px-3 py-2" />
      <input name="source" placeholder="Source (e.g. field observation)" class="w-full rounded border border-border px-3 py-2" />
      <select name="verificationStatus" class="w-full rounded border border-border px-3 py-2">
        <option value="reported">Reported</option><option value="reviewed">Reviewed</option><option value="verified">Verified</option><option value="attested">Attested</option>
      </select>
      <button type="submit" class="px-4 py-2 rounded bg-primary text-white text-sm">Create</button>
    </form>
    <p id="r" class="mt-4 text-sm"></p>
  </section>
  <script>
    document.getElementById("f")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      const res = await fetch("/api/admin/measurements", { method: "POST", body: fd });
      const j = await res.json();
      const el = document.getElementById("r");
      if (el) el.textContent = res.ok ? `Created: ${j.data.id}` : (j.error ?? "Error");
    });
  </script>
</BaseLayout>
