---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getDb } from "@lib/db";
import { farms } from "@lib/schema";
import DeleteButton from "@components/admin/DeleteButton.astro";

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(farms); } catch {}
---
<BaseLayout title="Farms — Admin" description="Admin farms.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Farms (Admin)</h1>
    <a href="/admin/farms/new" class="mt-2 inline-block text-sm text-primary">+ New Farm</a>
    <p class="mt-2 text-muted text-sm">{list.length} records.</p>
    <ul class="mt-6 space-y-2">
      {list.map((f: any) => <li class="text-sm flex items-center gap-3">{f.name} — {f.status}<DeleteButton endpoint="/api/admin/farms" id={f.id} /></li>)}
    </ul>
  </section>
</BaseLayout>
