---
import AdminLayout from "@components/admin/AdminLayout.astro";
import { getDb } from "@lib/db";
import { farms } from "@lib/schema";
import DeleteButton from "@components/admin/DeleteButton.astro";
import { adminPageGuard } from "@lib/admin-page";
import Can from "@components/admin/Can.astro";
import StatusSelect from "@components/admin/StatusSelect.astro";
import BulkBar from "@components/admin/BulkBar.astro";
const denied = adminPageGuard(Astro, "farms.read");
if (denied) return denied;

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(farms); } catch {}
---
<AdminLayout title="Farms — Admin" description="Admin farms.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Farms (Admin)</h1>
    <Can capability="farms.create"><a href="/admin/farms/new" class="mt-2 inline-block text-sm text-primary">+ New Farm</a></Can>
    <p class="mt-2 text-muted text-sm">{list.length} records.</p>
    <ul class="mt-6 space-y-2">
      {list.map((f: any) => (
        <li class="text-sm flex flex-wrap items-center gap-3">
          <input type="checkbox" data-bulk-entity="farms" value={f.id} aria-label="Select record" />
          <span>{f.name} — {f.status}</span>
          <Can capability="farms.update"><a href={`/admin/farms/${f.id}/edit`} class="text-xs text-primary underline">Edit</a></Can>
          <StatusSelect entity="farm" id={f.id} capability="farms.publish" />
          <Can capability="farms.delete"><DeleteButton endpoint="/api/admin/farms" id={f.id} capability="farms.delete" /></Can>
        </li>
      ))}
    </ul>
        <BulkBar entity="farms" publishCapability="farms.publish" deleteCapability="farms.delete" />
  </section>
</AdminLayout>
