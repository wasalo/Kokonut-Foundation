---
import AdminLayout from "@components/admin/AdminLayout.astro";
import { getDb } from "@lib/db";
import { metrics } from "@lib/schema";
import DeleteButton from "@components/admin/DeleteButton.astro";
import StatusSelect from "@components/admin/StatusSelect.astro";
import { adminPageGuard } from "@lib/admin-page";
import Can from "@components/admin/Can.astro";
import BulkBar from "@components/admin/BulkBar.astro";
const denied = adminPageGuard(Astro, "metrics.read");
if (denied) return denied;

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(metrics); } catch {}
---
<AdminLayout title="Metrics — Admin" description="Admin metrics.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Metrics (Admin)</h1>
    <Can capability="metrics.create"><a href="/admin/metrics/new" class="mt-2 inline-block text-sm text-primary">+ New Metric</a></Can>
    <p class="mt-2 text-muted text-sm">{list.length} records.</p>
    <ul class="mt-6 space-y-2">
      {list.map((m: any) => (
        <li class="text-sm flex flex-wrap items-center gap-3">
          <input type="checkbox" data-bulk-entity="metrics" value={m.id} aria-label="Select record" />
          <span>{m.name}: {m.value} {m.unit} — <span class="px-2 py-0.5 rounded text-xs bg-surface-muted">{m.status ?? "published"}</span></span>
          <Can capability="metrics.update"><a href={`/admin/metrics/${m.id}/edit`} class="text-xs text-primary underline">Edit</a></Can>
          <StatusSelect entity="metric" id={m.id} capability="metrics.publish" />
          <Can capability="metrics.delete"><DeleteButton endpoint="/api/admin/metrics" id={m.id} capability="metrics.delete" /></Can>
        </li>
      ))}
    </ul>
        <BulkBar entity="metrics" publishCapability="metrics.publish" deleteCapability="metrics.delete" />
    <script>
      document.querySelectorAll(".status-sel").forEach((sel) => {
        sel.addEventListener("change", async (e) => {
          const t = e.target as HTMLSelectElement;
          const v = t.value;
          if (!v) return;
          await fetch("/api/admin/status", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ entityType: t.dataset.entity, entityId: t.dataset.id, status: v }) });
          location.reload();
        });
      });
    </script>
  </section>
</AdminLayout>
