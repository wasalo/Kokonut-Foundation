---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getDb } from "@lib/db";
import { metrics } from "@lib/schema";

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(metrics); } catch {}
---
<BaseLayout title="Metrics — Admin" description="Admin metrics.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Metrics (Admin)</h1>
    <a href="/admin/metrics/new" class="mt-2 inline-block text-sm text-primary">+ New Metric</a>
    <p class="mt-2 text-muted text-sm">{list.length} records.</p>
    <ul class="mt-6 space-y-2" data-delete-endpoint="/api/admin/metrics">
      {list.map((m: any) => (
        <li class="text-sm flex items-center gap-2">
          {m.name}: {m.value} {m.unit} — <span class="px-2 py-0.5 rounded text-xs bg-surface-muted">{m.status ?? "published"}</span>
          <select data-entity="metric" data-id={m.id} class="status-sel text-xs border border-border rounded px-1">
            <option value="">change…</option>
            <option value="draft">draft</option>
            <option value="submitted">submitted</option>
            <option value="verified">verified</option>
            <option value="published">published</option>
            <option value="rejected">rejected</option>
            <option value="archived">archived</option>
          </select>
        </li>
      ))}
    </ul>
    <script>
      document.querySelectorAll(".status-sel").forEach((sel) => {
        sel.addEventListener("change", async (e) => {
          const t = e.target as HTMLSelectElement;
          const v = t.value;
          if (!v) return;
          await fetch("/api/admin/status", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ entityType: t.dataset.entity, entityId: t.dataset.id, status: v }) });
          location.reload();
        });
      });
    </script>

    <script>
      const list = document.querySelector("[data-delete-endpoint]");
      if (list) {
        const endpoint = list.getAttribute("data-delete-endpoint");
        list.querySelectorAll(".status-sel").forEach((sel) => {
          const btn = document.createElement("button");
          btn.textContent = "Delete";
          btn.className = "text-xs text-critical underline";
          btn.addEventListener("click", async () => {
            if (!confirm("Delete this record? This cannot be undone.")) return;
            const res = await fetch(`${endpoint}?id=${encodeURIComponent(sel.dataset.id ?? "")}`, { method: "DELETE" });
            if (res.ok) location.reload();
          });
          sel.parentElement?.appendChild(btn);
        });
      }
    </script>
  </section>
</BaseLayout>
