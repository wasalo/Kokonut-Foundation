---
import BaseLayout from "@layouts/BaseLayout.astro";
---
<BaseLayout title="New Milestone — Admin" description="Create milestone.">
  <section class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">New Milestone</h1>
    <form id="f" class="mt-6 space-y-4">
      <input name="projectId" placeholder="Project ID" required class="w-full rounded border border-border px-3 py-2" />
      <input name="title" placeholder="Title" required class="w-full rounded border border-border px-3 py-2" />
      <textarea name="description" placeholder="Description" rows="3" class="w-full rounded border border-border px-3 py-2"></textarea>
      <select name="status" class="w-full rounded border border-border px-3 py-2">
        <option value="planned">Planned</option><option value="active">Active</option><option value="completed">Completed</option>
      </select>
      <input name="dueDate" type="date" class="w-full rounded border border-border px-3 py-2" />
      <button type="submit" class="px-4 py-2 rounded bg-primary text-white text-sm">Create</button>
    </form>
    <p id="r" class="mt-4 text-sm"></p>
  </section>
  <script>
    document.getElementById("f")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      const res = await fetch("/api/admin/milestones", { method: "POST", body: fd });
      const j = await res.json();
      const el = document.getElementById("r");
      if (el) el.textContent = res.ok ? `Created: ${j.data.id}` : (j.error ?? "Error");
    });
  </script>
</BaseLayout>
