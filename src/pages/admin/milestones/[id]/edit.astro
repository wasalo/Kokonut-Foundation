---
import AdminLayout from "@components/admin/AdminLayout.astro";
import EntityForm from "@components/admin/EntityForm.astro";
import { adminPageGuard } from "@lib/admin-page";
const denied = adminPageGuard(Astro, "milestones.update");
if (denied) return denied;

import { getDb } from "@lib/db";
import { milestones } from "@lib/schema";
import { eq } from "drizzle-orm";

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
const id = Astro.params.id as string;
let record: Record<string, unknown> = {};
try { if (db) record = (await db.select().from(milestones).where(eq(milestones.id, id)).get()) ?? {}; } catch {}
---
<AdminLayout title="Edit Milestone — Admin" description="Admin Milestone edit.">
  <section class="max-w-2xl mx-auto px-4 py-16">
    <a href="/admin/milestones" class="text-sm text-primary">← Milestones</a>
    <h1 class="mt-2 text-3xl font-bold text-strong">Edit Milestone</h1>
    <p class="mt-2 text-sm text-muted">{String(record.title ?? id)}</p>
    <EntityForm
      endpoint="/api/admin/milestones"
      id={id}
      submitLabel="Save changes"
      record={record}
      fields={[
        { name: "title", label: "Title", required: true },
        { name: "projectId", label: "Project ID", required: true },
        { name: "description", label: "Description", type: "textarea" },
        { name: "status", label: "Status", type: "select", options: [
            { value: "draft", label: "draft" },
            { value: "submitted", label: "submitted" },
            { value: "verified", label: "verified" },
            { value: "published", label: "published" },
            { value: "rejected", label: "rejected" },
            { value: "archived", label: "archived" },
          ] },
        { name: "dueDate", label: "Due date" },
        { name: "completedAt", label: "Completed at" },
      ]}
    />
  </section>
</AdminLayout>
