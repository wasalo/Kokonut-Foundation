---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/primitives/Card.astro";
import Breadcrumb from "@components/primitives/Breadcrumb.astro";
import { getDb } from "@lib/db";
import { methodologies } from "@lib/schema";
import { eq } from "drizzle-orm";

const slug = Astro.params.slug as string;
const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let m: any = null;
try { if (db) m = await db.select().from(methodologies).where(eq(methodologies.slug, slug)).get(); } catch {}
if (!m) m = { slug, name: slug, description: "", version: "", documentKey: null };
---
<BaseLayout title={`${m.name} — Methodology`} description={m.description ?? ""}>
  <section class="max-w-3xl mx-auto px-4 py-16">
    <Breadcrumb items={[{ href: "/", label: "Home" }, { href: "/impact", label: "Impact" }, { href: "/impact/methodology", label: "Methodology" }, { label: m.name }]} />
    <a href="/impact/methodology" class="text-sm text-primary mt-2 inline-block">← Methodology</a>
    <h1 class="mt-4 text-3xl font-bold text-strong">{m.name}</h1>
    {m.version && <p class="mt-2 text-xs text-muted">Version {m.version}</p>}
    <Card class="mt-6">
      <p class="text-muted">{m.description || "No description."}</p>
      {m.documentKey && <a href={`/api/v1/downloads/reports/${m.slug}`} class="mt-3 inline-block text-sm text-primary">Document →</a>}
    </Card>
  </section>
</BaseLayout>
