---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/primitives/Card.astro";
import Breadcrumb from "@components/primitives/Breadcrumb.astro";
import { getDb } from "@lib/db";
import { metrics, measurements, evidence, farms, attestations, methodologies, sources } from "@lib/schema";
import { eq } from "drizzle-orm";
import { parseJson } from "@lib/utils";

const slug = Astro.params.metric as string;
const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let metric: any = null;
let history: any[] = [];
let ev: any[] = [];
let farm: any = null;
let attestationsList: any[] = [];
let methodology: any = null;
let source: any = null;
try {
  if (db) {
    metric = await db.select().from(metrics).where(eq(metrics.slug, slug)).get();
    if (metric) {
      history = await db.select().from(measurements).where(eq(measurements.metricId, metric.id));
      ev = await db.select().from(evidence).where(eq(evidence.metricId, metric.id));
      attestationsList = await db.select().from(attestations).where(eq(attestations.metricId, metric.id));
      if (metric.projectId) {
        const farmRows = await db.select().from(farms).where(eq(farms.projectId, metric.projectId));
        farm = farmRows[0] ?? null;
      }
      if (metric.methodology) methodology = await db.select().from(methodologies).where(eq(methodologies.slug, metric.methodology)).get();
      if (metric.source) source = await db.select().from(sources).where(eq(sources.slug, metric.source)).get();
    }
  }
} catch {}
if (!metric) metric = { slug, name: slug, description: "", category: "", value: 0, unit: "", verificationStatus: "reported", source: "" };
const histJson = JSON.stringify(history.map((h: any) => ({ date: h.observedAt, value: h.value })));
---
<BaseLayout title={`${metric.name} — Impact`} description={metric.description}>
  <section class="max-w-7xl mx-auto px-4 py-16">
    <Breadcrumb items={[{ href: "/", label: "Home" }, { href: "/impact", label: "Impact" }, { label: metric.name }]} />
    <a href="/impact" class="text-sm text-primary mt-2 inline-block">← Impact</a>
    <h1 class="mt-4 text-3xl font-bold text-strong">{metric.name}</h1>
    <p class="mt-2 text-muted">{metric.description}</p>
    <div class="mt-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 space-y-6">
        <Card>
          <h2 class="font-semibold text-strong">Current Value</h2>
          <div class="mt-2 text-3xl font-bold text-primary">{metric.value} {metric.unit}</div>
          <p class="mt-2 text-sm text-muted">Status: {metric.verificationStatus} · Source: {metric.source}</p>
          {metric.methodology && <p class="mt-2 text-sm text-muted">Methodology: {metric.methodology}</p>}
        </Card>
        <Card>
          <h2 class="font-semibold text-strong">History</h2>
          <canvas id="chart" height="200"></canvas>
        </Card>
        {ev.length > 0 && (
          <Card>
            <h2 class="font-semibold text-strong">Evidence</h2>
            <ul class="mt-3 space-y-2">
              {ev.map((e: any) => (
                <li class="text-sm"><a href={e.externalUrl ?? `/api/v1/downloads/evidence/${e.id}`} class="text-primary">{e.title}</a> <span class="text-muted">({e.type} · {e.evidenceClass ?? "measurement"} · {e.maturity ?? "structured"})</span></li>
              ))}
            </ul>
          </Card>
        )}
        <Card>
          <h2 class="font-semibold text-strong">Provenance Chain</h2>
          <p class="mt-2 text-xs text-muted">Metric → Farm → Measurement → Evidence → Methodology → Attestation → Source</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><strong>Metric:</strong> {metric.name} ({metric.verificationStatus})</li>
            {farm && <li><strong>Farm:</strong> <a href={`/farms/${farm.slug}`} class="text-primary">{farm.name}</a></li>}
            <li><strong>Measurements:</strong> {history.length} recorded</li>
            <li><strong>Evidence:</strong> {ev.length} items</li>
            {methodology && <li><strong>Methodology:</strong> <a href={`/impact/methodology/${methodology.slug}`} class="text-primary">{methodology.name}</a></li>}
            {attestationsList.length > 0 && <li><strong>Attestations:</strong> {attestationsList.length} (see /transparency/attestations)</li>}
            {source && <li><strong>Source:</strong> {source.url ? <a href={source.url} class="text-primary" target="_blank" rel="noopener">{source.name}</a> : source.name}</li>}
          </ul>
          <a href={`/api/v1/graph/metric/${metric.slug}`} class="mt-3 inline-block text-xs text-primary">View graph JSON →</a>
        </Card>
      </div>
      <div>
        <Card>
          <h3 class="font-semibold text-strong">Category</h3>
          <p class="mt-2 text-sm text-muted">{metric.category}</p>
        </Card>
      </div>
    </div>
  </section>
  <script type="module" define:vars={{ histJson }}>
    const data = JSON.parse(histJson);
    (async () => {
      const { Chart, registerables } = await import("https://cdn.jsdelivr.net/npm/chart.js@4/+esm");
      Chart.register(...registerables);
      const ctx = document.getElementById("chart");
      if (!ctx) return;
      const css = getComputedStyle(document.documentElement);
      const accent = css.getPropertyValue("--primary").trim() || "#009F4D";
      const grid = css.getPropertyValue("--border").trim() || "#E2E8E5";
      const label = css.getPropertyValue("--muted").trim() || "#5B6B63";
      new Chart(ctx, {
        type: "line",
        data: {
          labels: data.map((d) => d.date),
          datasets: [{ label: "Value", data: data.map((d) => d.value), borderColor: accent, backgroundColor: accent + "22", tension: 0.3, fill: true }],
        },
        options: {
          responsive: true,
          plugins: { legend: { labels: { color: label } } },
          scales: {
            x: { ticks: { color: label }, grid: { color: grid } },
            y: { ticks: { color: label }, grid: { color: grid } },
          },
        },
      });
    })();
  </script>
</BaseLayout>
