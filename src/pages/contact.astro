---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/primitives/Button.astro";
const env = (Astro.locals as any).runtime?.env ?? {};
const siteKey = env.TURNSTILE_SITE_KEY || "1x00000000000000000000AA";
---
<BaseLayout title="Contact — Kokonut Foundation" description="Contact the Foundation.">
  <section class="max-w-2xl mx-auto px-4 py-16">
    <script type="module">fetch("/api/v1/events",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({event:"contact_view"})}).catch(()=>{});</script>
    <h1 class="text-3xl font-bold text-strong">Contact</h1>
    <form id="contact-form" class="mt-8 space-y-4" method="POST" action="/api/v1/inquiries">
      <input type="hidden" name="type" value="contact" />
      <div>
        <label class="block text-sm font-medium" for="name">Name</label>
        <input id="name" name="name" required class="mt-1 w-full rounded-md border border-border px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm font-medium" for="email">Email</label>
        <input id="email" name="email" type="email" required class="mt-1 w-full rounded-md border border-border px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm font-medium" for="organization">Organization</label>
        <input id="organization" name="organization" class="mt-1 w-full rounded-md border border-border px-3 py-2" />
      </div>
      <div>
        <label class="block text-sm font-medium" for="message">Message</label>
        <textarea id="message" name="message" required rows="5" class="mt-1 w-full rounded-md border border-border px-3 py-2"></textarea>
      </div>
      <div class="cf-turnstile" data-sitekey={siteKey}></div>
      <Button type="submit" variant="primary">Send</Button>
    </form>
    <p id="result" class="mt-4 text-sm"></p>
  </section>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const res = await fetch("/api/v1/inquiries", { method: "POST", body: fd });
      const json = await res.json();
      const el = document.getElementById("result");
      if (el) el.textContent = res.ok ? "Thanks — we'll be in touch." : (json.error ?? "Error");
    });
  </script>
</BaseLayout>
