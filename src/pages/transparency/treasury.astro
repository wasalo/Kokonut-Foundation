---
import BaseLayout from "@layouts/BaseLayout.astro";
---
<BaseLayout title="Treasury — Kokonut Foundation" description="Treasury transparency.">
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Treasury</h1>
    <p class="mt-4 text-muted">Verified wallet addresses, balances, assets, transaction history, categorized expenditures, project funding and explorer links will be published here.</p>
    <p class="mt-4 text-muted text-sm">Blockchain data displayed here distinguishes raw on-chain information from Foundation interpretation/category labels.</p>
  </section>
</BaseLayout>
