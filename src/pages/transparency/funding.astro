---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/primitives/Card.astro";
import { getDb } from "@lib/db";
import { fundingEvents } from "@lib/schema";
import { getTranslator, resolveLocale } from "@lib/i18n";
const t = getTranslator(resolveLocale(Astro));

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(fundingEvents); } catch {}
---
<BaseLayout title="Funding — Kokonut Foundation" description="Funding events.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">{t("fund.title")}</h1>
    <p class="mt-4 text-muted">{t("fund.lede")}</p>
    <h2 class="sr-only">Funding events</h2>
    <div class="mt-8 space-y-3">
      {list.length === 0 && <p class="text-muted">No funding events yet.</p>}
      {list.map((f: any) => (
        <Card>
          <h3 class="font-semibold text-strong">{f.title}</h3>
          <p class="mt-1 text-xs text-muted">{f.funder ?? "—"} · {f.occurredAt?.slice(0, 10)}</p>
          {f.amount && <p class="mt-2 text-sm text-muted">{f.amount} {f.currency ?? ""}</p>}
          {f.category && <p class="mt-1 text-xs text-muted">{f.category}</p>}
        </Card>
      ))}
    </div>
  </section>
</BaseLayout>
