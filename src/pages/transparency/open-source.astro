---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/primitives/Card.astro";
import { getDb } from "@lib/db";
import { resources } from "@lib/schema";

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(resources); } catch {}
list = list.filter((r: any) => r.resourceType === "Open Source" || r.resourceType === "Framework");
---
<BaseLayout title="Open Source — Kokonut Foundation" description="Open-source outputs.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-strong">Open Source</h1>
    <p class="mt-4 text-muted">Open-source outputs and resources.</p>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      {list.length === 0 && <p class="text-muted">No open-source resources yet.</p>}
      {list.map((r: any) => (
        <a href={`/resources/${r.slug}`} class="block">
          <Card><h3 class="font-semibold text-strong">{r.title}</h3><p class="mt-2 text-sm text-muted">{r.summary}</p></Card>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
