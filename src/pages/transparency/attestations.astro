---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/primitives/Card.astro";
import { getDb } from "@lib/db";
import { attestations } from "@lib/schema";
import { getTranslator, resolveLocale } from "@lib/i18n";
const t = getTranslator(resolveLocale(Astro));

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(attestations); } catch {}
---
<BaseLayout title="Attestations — Kokonut Foundation" description="Public attestations.">
  <section class="max-w-7xl mx-auto px-4 py-16">
  <script type="module">fetch("/api/v1/events",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({event:"attestations_view"})}).catch(()=>{});</script>
    <h1 class="text-3xl font-bold text-strong">{t("att.title")}</h1>
    <p class="mt-4 text-muted">{t("att.lede")}</p>
    <div class="mt-6">
      <Card>
        <h2 class="font-semibold text-strong text-sm">EAS Schemas (Celo)</h2>
        <ul class="mt-2 text-xs text-muted space-y-1 font-mono">
          <li>kokonut-mrv: 0x93af67b8197dda513fa968e597e1c9a2c0d0607d656659f153dc1b065a100e54</li>
          <li>kokonut-impact: 0xb99bb4b2a55218b8f4df1f0bd4c39400711809f13ef5d150d2903648c6590dfe</li>
          <li>kokonut-financial: 0x75b42beb85dd852134dfaff3de41b8dc361ed0cb2bf93ce3009c8ec082de905b</li>
          <li>kokonut-harvest: 0xb359f9756e3cb3597e4048dccae2842083359906fbae8dc8c0e9af8ac1b3ccff</li>
          <li>kokonut-compliance: 0x59632edcf1d04be0c2dcfd572282bbd4dac518e7a92872ec45ade29876ef95f5</li>
          <li>kokonut-data-post: 0xf0de37f5c4a441aedb794d5585201c6ef150543dc53f894e1212f7e330205045</li>
        </ul>
      </Card>
    </div>
    <h2 class="sr-only">Attestations</h2>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
      {list.length === 0 && <p class="text-muted">No attestations yet.</p>}
      {list.map((a: any) => (
        <Card>
          <h3 class="font-semibold text-strong">{a.title}</h3>
          <p class="mt-1 text-xs text-muted">{a.source} · {a.verificationStatus}</p>
          {a.description && <p class="mt-2 text-sm text-muted">{a.description}</p>}
          {a.externalUrl && <a href={a.externalUrl} class="mt-3 inline-block text-sm text-primary" target="_blank" rel="noopener">View source →</a>}
        </Card>
      ))}
    </div>
  </section>
</BaseLayout>
