---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/primitives/Card.astro";
const modules = [
  { href: "/transparency/governance", title: "Governance", desc: "Foundation governance and decision-making." },
  { href: "/transparency/treasury", title: "Treasury", desc: "Wallets, balances, expenditures." },
  { href: "/transparency/attestations", title: "Attestations", desc: "EAS and Kokonut Intelligence attestations." },
  { href: "/transparency/reports", title: "Reports", desc: "Published reports and documents." },
  { href: "/explorer/evidence", title: "Evidence", desc: "Supporting evidence browser." },
  { href: "/transparency/funding", title: "Funding", desc: "Funding events and public-goods contributions." },
  { href: "/transparency/methodologies", title: "Methodologies", desc: "Impact measurement methodologies." },
  { href: "/transparency/open-source", title: "Open Source", desc: "Open-source outputs and resources." },
];
---
<BaseLayout title="Transparency — Kokonut Foundation" description="Public accountability.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <script type="module">fetch("/api/v1/events",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({event:"transparency_view"})}).catch(()=>{});</script>
    <h1 class="text-3xl md:text-5xl font-bold text-strong">Transparency</h1>
    <p class="mt-4 text-muted">Public accountability information consolidated in one place.</p>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
      {modules.map((m) => (
        <a href={m.href} class="block">
          <Card>
            <h3 class="font-semibold text-strong">{m.title}</h3>
            <p class="mt-2 text-sm text-muted">{m.desc}</p>
          </Card>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
