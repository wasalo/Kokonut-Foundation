---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/primitives/Card.astro";
import { getDb } from "@lib/db";
import { partners } from "@lib/schema";
import { localePath, resolveLocale } from "@lib/i18n";
const locale = resolveLocale(Astro);
const path = (p: string) => localePath(locale, p);

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(partners); } catch {}
if (!list.length) {
  list = [
    { slug: "kokonut-network", name: "Kokonut Network", type: "Community", description: "Community governance network.", country: "Global" },
  ];
}
---
<BaseLayout title="Partners — Kokonut Foundation" description="Foundation partners." jsonLd={{ "@context": "https://schema.org", "@type": "CollectionPage", "name": "Partners" }}>
  <section class="max-w-7xl mx-auto px-4 py-16">
  <script type="module">fetch("/api/v1/events",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({event:"partners_view"})}).catch(()=>{});</script>
    <h1 class="text-3xl md:text-5xl font-bold text-strong">Partners</h1>
    <p class="mt-4 text-muted">Organizations collaborating with the Foundation.</p>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { t: "Nonprofits & NGOs", d: "Implementation partners delivering training, community infrastructure, and field support on the ground." },
        { t: "Foundations & funders", d: "Public-goods capital for farm infrastructure, with scoped requests and explicit closeout." },
        { t: "Research institutions", d: "Methodology, baselines, and independent review of ecological and financial evidence." },
        { t: "Technology builders", d: "Open-source tooling for evidence, reporting, and governed data infrastructure." },
      ].map((c) => (
        <Card>
          <h3 class="font-semibold text-strong text-sm">{c.t}</h3>
          <p class="mt-2 text-sm text-muted">{c.d}</p>
        </Card>
      ))}
    </div>
    <h2 class="sr-only">Current partners</h2>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      {list.map((p: any) => (
        <a href={`/partners/${p.slug}`} class="block">
          <Card>
            <h3 class="font-semibold text-strong">{p.name}</h3>
            <p class="mt-1 text-xs text-muted">{p.type}{p.country ? ` · ${p.country}` : ""}</p>
            <p class="mt-2 text-sm text-muted">{p.description}</p>
          </Card>
        </a>
      ))}
    </div>
    <div class="mt-12">
      <a href={path("/contact")} class="text-primary">Explore a partnership →</a>
    </div>
  </section>
</BaseLayout>
