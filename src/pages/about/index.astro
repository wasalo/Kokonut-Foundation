---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/primitives/Card.astro";
import Button from "@components/primitives/Button.astro";
import { localePath, resolveLocale } from "@lib/i18n";
const locale = resolveLocale(Astro);
const path = (p: string) => localePath(locale, p);
---
<BaseLayout
  title="About — Kokonut Foundation"
  description="The first nonprofit deploying the Kokonut Framework."
>
  <section class="max-w-3xl mx-auto px-4 py-16">
    <script type="module">fetch("/api/v1/events",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({event:"about_view"})}).catch(()=>{});</script>
    <h1 class="text-3xl md:text-5xl font-bold text-strong">About Kokonut Foundation</h1>
    <p class="mt-4 text-lg text-muted">
      Kokonut Foundation is the first nonprofit deploying the Kokonut Framework. It grows regenerative farms through community governance, public data and regenerative value.
    </p>
    <p class="mt-4 text-muted">
      The Foundation exists to make regenerative production legible and accountable: what was planned, what actually happened, what evidence supports it, and what remains uncertain. It is a
      public-interest institution, not a marketing surface for a token.
    </p>
  </section>

  <section class="bg-surface-muted py-16">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-strong">What we are trying to solve</h2>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
        <Card>
          <h3 class="font-semibold text-strong">Capital that reaches the land</h3>
          <p class="mt-2 text-sm text-muted">
            Funding for regenerative agriculture rarely arrives with the infrastructure, training, and patient structure that a farm actually needs. The Foundation sources capital against
            scoped, reviewable requests.
          </p>
        </Card>
        <Card>
          <h3 class="font-semibold text-strong">Evidence that survives scrutiny</h3>
          <p class="mt-2 text-sm text-muted">
            Claims about soil, harvests, revenue, and community benefit are easy to make and hard to check. We publish records with their method, source, reviewer, and limitations attached.
          </p>
        </Card>
        <Card>
          <h3 class="font-semibold text-strong">Value that stays local</h3>
          <p class="mt-2 text-sm text-muted">
            Operators must retain authority over their land and their methods. Shared methodology and shared capital should support local execution, not replace it.
          </p>
        </Card>
      </div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 py-16">
    <h2 class="text-2xl font-bold text-strong">Our commitments</h2>
    <ul class="mt-6 space-y-3 text-muted">
      <li><strong class="text-strong">Evidence before claims.</strong> We distinguish documented state, measurement, derived indicator, forecast, and interpretation — and we say which one we are using.</li>
      <li><strong class="text-strong">Forecast and actual stay separate.</strong> Plans are not erased when reality arrives; both are visible so the next plan can improve.</li>
      <li><strong class="text-strong">Open by default.</strong> Public information is easy to discover, link, and verify. Sensitive evidence stays private with consent, not hidden by default.</li>
      <li><strong class="text-strong">Local authority.</strong> Farm operators decide how their land is worked. Shared standards exist to make farms comparable, not identical.</li>
      <li><strong class="text-strong">Public-good framing.</strong> We describe allocations and contributions as public-good commitments, not as investor returns.</li>
    </ul>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
      <a href={path("/about/foundation")}><Card><h2 class="font-semibold text-strong">The Foundation</h2><p class="mt-2 text-sm text-muted">Mission, model, and the relationship with Kokonut Network.</p></Card></a>
      <a href={path("/about/team")}><Card><h2 class="font-semibold text-strong">Team</h2><p class="mt-2 text-sm text-muted">The people behind the Foundation.</p></Card></a>
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={path("/how-it-works")} variant="primary">How It Works</Button>
      <Button href={path("/transparency/governance")} variant="secondary">Governance</Button>
    </div>
  </section>
</BaseLayout>
