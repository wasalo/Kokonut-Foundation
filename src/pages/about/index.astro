---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/primitives/Card.astro";
---
<BaseLayout title="About — Kokonut Foundation" description="About the Foundation.">
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-3xl md:text-5xl font-bold text-strong">About Kokonut Foundation</h1>
    <p class="mt-4 text-muted">Kokonut Foundation is the first nonprofit deploying the Kokonut Framework. It grows regenerative farms through community governance, public data and regenerative value.</p>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
      <a href="/about/foundation"><Card><h3 class="font-semibold text-strong">The Foundation</h3><p class="mt-2 text-sm text-muted">Mission, model, relationship with Kokonut Network.</p></Card></a>
      <a href="/about/team"><Card><h3 class="font-semibold text-strong">Team</h3><p class="mt-2 text-sm text-muted">People behind the Foundation.</p></Card></a>
    </div>
  </section>
</BaseLayout>
