---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/primitives/Card.astro";
import Badge from "@components/primitives/Badge.astro";
import Breadcrumb from "@components/primitives/Breadcrumb.astro";
import { getDb } from "@lib/db";
import { projects, metrics, milestones, partners, projectPartners, farms, evidence, resources, naturalAssets, activities } from "@lib/schema";
import { eq } from "drizzle-orm";
import { parseJson, formatDate } from "@lib/utils";
import { localePath, resolveLocale } from "@lib/i18n";
import { getTranslator, resolveLocale } from "@lib/i18n";
const t = getTranslator(resolveLocale(Astro));
const locale = resolveLocale(Astro);
const path = (p: string) => localePath(locale, p);

const slug = Astro.params.slug as string;
const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;

let project: any = null;
let projectMetrics: any[] = [];
let projectMilestones: any[] = [];
let projectFarms: any[] = [];
let projectEvidence: any[] = [];
let projectResources: any[] = [];
let projectNaturalAssets: any[] = [];
let projectActivities: any[] = [];

try {
  if (db) {
    project = await db.select().from(projects).where(eq(projects.slug, slug)).get();
    if (project) {
      const ids = parseJson<string[]>(project.metrics, []);
      if (ids.length) {
        const all = await db.select().from(metrics);
        projectMetrics = all.filter((m: any) => ids.includes(m.id) || m.projectId === project.id);
      } else {
        projectMetrics = await db.select().from(metrics).where(eq(metrics.projectId, project.id));
      }
      projectMilestones = await db.select().from(milestones).where(eq(milestones.projectId, project.id));
      projectFarms = await db.select().from(farms).where(eq(farms.projectId, project.id));
      projectEvidence = await db.select().from(evidence).where(eq(evidence.projectId, project.id));
      projectResources = await db.select().from(resources).where(eq(resources.projectId, project.id));
      projectNaturalAssets = await db.select().from(naturalAssets).where(eq(naturalAssets.projectId, project.id));
      projectActivities = await db.select().from(activities).where(eq(activities.projectId, project.id));
    }
  }
} catch {}

if (!project) {
  project = {
    slug,
    name: "Adelphi Regenerative Farm",
    summary: "Live regenerative farm in the Dominican Republic.",
    description: "Adelphi is a live regenerative farm implementing the Kokonut Framework in the Dominican Republic. It demonstrates Fund → Grow → Verify → Repeat.",
    status: "active",
    projectType: "Regenerative Farm",
    country: "Dominican Republic",
    region: "Adelphi",
    impactAreas: '["Ecology","Agriculture","Community"]',
    sdgs: "[2,13,15]",
    metrics: "[]",
  };
}

const impactAreas = parseJson<string[]>(project.impactAreas, []);
const sdgs = parseJson<number[]>(project.sdgs, []);
---
<BaseLayout title={`${project.name} — Kokonut Foundation`} description={project.summary} jsonLd={{ "@context": "https://schema.org", "@type": "Article", "headline": project.name, "description": project.summary, "breadcrumb": { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://kokonut.foundation/" }, { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://kokonut.foundation/projects" }, { "@type": "ListItem", "position": 3, "name": project.name }] } }}>
  <section class="max-w-7xl mx-auto px-4 py-16">
    <Breadcrumb items={[{ href: "/", label: "Home" }, { href: "/projects", label: "Projects" }, { label: project.name }]} />
    <a href={path("/projects")} class="text-sm text-primary mt-2 inline-block">← Projects</a>
    <div class="mt-4 flex items-start justify-between flex-wrap gap-4">
      <div>
        <h1 class="text-3xl md:text-5xl font-bold text-strong">{project.name}</h1>
        <p class="mt-2 text-muted">{project.summary}</p>
      </div>
      <Badge tone="success">{project.status}</Badge>
    </div>

    <div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 space-y-6">
        <Card>
          <h2 class="font-semibold text-strong">{t("detail.overview")}</h2>
          <p class="mt-2 text-muted">{project.description}</p>
        </Card>
        <Card>
          <h2 class="font-semibold text-strong">{t("detail.purpose")}</h2>
          <p class="mt-2 text-muted">Demonstrate regenerative agriculture combined with community governance and public verification.</p>
        </Card>
        {projectMetrics.length > 0 && (
          <Card>
            <h2 class="font-semibold text-strong">{t("detail.impact")}</h2>
            <div class="mt-4 grid grid-cols-2 md:grid-cols-3 gap-4">
              {projectMetrics.map((m: any) => (
                <div class="text-center">
                  <div class="text-2xl font-bold text-primary">{m.value} {m.unit}</div>
                  <div class="text-xs text-muted">{m.name}</div>
                </div>
              ))}
            </div>
          </Card>
        )}
        {projectNaturalAssets.length > 0 && (
          <Card>
            <h2 class="font-semibold text-strong">{t("detail.assets")}</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {projectNaturalAssets.map((a: any) => <li>{a.name} ({a.assetType})</li>)}
            </ul>
          </Card>
        )}
        {projectActivities.length > 0 && (
          <Card>
            <h2 class="font-semibold text-strong">{t("detail.activities")}</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {projectActivities.map((a: any) => <li>{a.name}{a.occurredAt ? ` — ${formatDate(a.occurredAt)}` : ""}</li>)}
            </ul>
          </Card>
        )}
        {projectEvidence.length > 0 && (
          <Card>
            <h2 class="font-semibold text-strong">{t("detail.evidence")}</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {projectEvidence.map((e: any) => (
                <li><a href={e.externalUrl ?? `/api/v1/downloads/evidence/${e.id}`} class="text-primary">{e.title}</a> <span class="text-muted">({e.type})</span></li>
              ))}
            </ul>
          </Card>
        )}
        {projectResources.length > 0 && (
          <Card>
            <h2 class="font-semibold text-strong">{t("detail.resources")}</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {projectResources.map((r: any) => <li><a href={`/resources/${r.slug}`} class="text-primary">{r.title}</a></li>)}
            </ul>
          </Card>
        )}
        {projectMilestones.length > 0 && (
          <Card>
            <h2 class="font-semibold text-strong">Timeline</h2>
            <ul class="mt-3 space-y-2">
              {projectMilestones.map((m: any) => (
                <li class="flex gap-2 text-sm">
                  <span class="text-primary">●</span>
                  <span><strong>{m.title}</strong> — {m.status}{m.dueDate ? ` (${formatDate(m.dueDate)})` : ""}</span>
                </li>
              ))}
            </ul>
          </Card>
        )}
      </div>
      <div class="space-y-6">
        <Card>
          <h3 class="font-semibold text-strong">Location</h3>
          <p class="mt-2 text-sm text-muted">{project.region ? `${project.region}, ` : ""}{project.country}</p>
          {project.latitude && <p class="text-xs text-muted mt-1">{project.latitude}, {project.longitude}</p>}
          {project.latitude && (
            <div id="pmap" style="height:200px" class="mt-3 rounded" data-lat={project.latitude} data-lng={project.longitude}></div>
          )}
        </Card>
        <Card>
          <h3 class="font-semibold text-strong">Type</h3>
          <p class="mt-2 text-sm text-muted">{project.projectType}</p>
        </Card>
        <Card>
          <h3 class="font-semibold text-strong">SDGs</h3>
          <p class="mt-2 text-sm text-muted">{sdgs.join(", ") || "—"}</p>
        </Card>
        {projectFarms.length > 0 && (
          <Card>
            <h3 class="font-semibold text-strong">Farms</h3>
            <ul class="mt-2 text-sm text-muted space-y-1">
              {projectFarms.map((f: any) => <li><a href={`/farms/${f.slug}`} class="text-primary">{f.name}</a></li>)}
            </ul>
          </Card>
        )}
        <Card>
          <h3 class="font-semibold text-strong">Impact Areas</h3>
          <p class="mt-2 text-sm text-muted">{impactAreas.join(", ") || "—"}</p>
        </Card>
      </div>
    </div>
  </section>
  <script type="module">
    fetch("/api/v1/events", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ event: "project_view" }) }).catch(() => {});
    const el = document.getElementById("pmap");
    if (el) {
      const lat = Number(el.dataset.lat);
      const lng = Number(el.dataset.lng);
      const mod = await import("https://unpkg.com/leaflet@1.9.4/dist/leaflet-src.esm.js");
      const L = mod.default ?? mod;
      const map = L.map(el).setView([lat, lng], 10);
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { attribution: "© OpenStreetMap" }).addTo(map);
      L.marker([lat, lng]).addTo(map);
    }
  </script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
</BaseLayout>
