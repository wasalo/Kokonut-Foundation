---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/primitives/Card.astro";
import { getDb } from "@lib/db";
import { farms, metrics } from "@lib/schema";
import { eq } from "drizzle-orm";

const slug = Astro.params.slug as string;
const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let farm: any = null;
let farmMetrics: any[] = [];
try {
  if (db) {
    farm = await db.select().from(farms).where(eq(farms.slug, slug)).get();
    if (farm?.projectId) farmMetrics = await db.select().from(metrics).where(eq(metrics.projectId, farm.projectId));
  }
} catch {}
if (!farm) farm = { slug, name: slug, country: "", region: "", areaM2: 0, latitude: null, longitude: null, description: "", status: "active" };
---
<BaseLayout title={`${farm.name} — Kokonut Foundation`} description={farm.description ?? ""}>
  <section class="max-w-7xl mx-auto px-4 py-16">
    <a href="/farms" class="text-sm text-primary">← Farms</a>
    <h1 class="mt-4 text-3xl font-bold text-strong">{farm.name}</h1>
    <p class="mt-2 text-muted">{farm.region ? `${farm.region}, ` : ""}{farm.country}</p>
    <div class="mt-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 space-y-6">
        <Card>
          <h2 class="font-semibold text-strong">Overview</h2>
          <p class="mt-2 text-muted">{farm.description || "No description."}</p>
          {farm.founders && <p class="mt-2 text-sm text-muted"><strong>Founders:</strong> {farm.founders}</p>}
          {farm.frameworkPhase && <p class="mt-1 text-sm text-muted"><strong>Framework phase:</strong> {farm.frameworkPhase}</p>}
          {farm.fundingRef && <p class="mt-1 text-sm text-muted"><strong>Funding:</strong> {farm.fundingRef}</p>}
        </Card>
        {farmMetrics.length > 0 && (
          <Card>
            <h2 class="font-semibold text-strong">Metrics</h2>
            <div class="mt-4 grid grid-cols-2 md:grid-cols-3 gap-4">
              {farmMetrics.map((m: any) => (
                <div class="text-center">
                  <div class="text-2xl font-bold text-primary">{m.value} {m.unit}</div>
                  <div class="text-xs text-muted">{m.name}</div>
                </div>
              ))}
            </div>
          </Card>
        )}
      </div>
      <div class="space-y-6">
        <Card>
          <h3 class="font-semibold text-strong">Location</h3>
          {farm.region && <p class="mt-2 text-sm text-muted">{farm.region}</p>}
          {farm.latitude && <p class="mt-1 text-sm text-muted">{farm.latitude}, {farm.longitude}</p>}
          {farm.areaM2 && <p class="mt-1 text-sm text-muted">Total: {farm.areaM2.toLocaleString()} m²</p>}
          {farm.agriculturalAreaM2 && <p class="mt-1 text-sm text-muted">Agricultural: {farm.agriculturalAreaM2.toLocaleString()} m²</p>}
          {farm.jobs && <p class="mt-1 text-sm text-muted">Jobs: {farm.jobs}</p>}
          {farm.publicGoodsAllocation != null && <p class="mt-1 text-sm text-muted">Public goods allocation: {farm.publicGoodsAllocation}%</p>}
        </Card>
        <Card>
          <h3 class="font-semibold text-strong">Status</h3>
          <p class="mt-2 text-sm text-muted">{farm.status} · {farm.lifecycleState ?? "draft"}</p>
        </Card>
      </div>
    </div>
  </section>
</BaseLayout>
