---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/primitives/Card.astro";
import { getDb } from "@lib/db";
import { farms, projects } from "@lib/schema";
import { getTranslator, resolveLocale } from "@lib/i18n";
const t = getTranslator(resolveLocale(Astro));

const env = (Astro.locals as any).runtime?.env ?? {};
const db = env.DB ? getDb(env) : null;
let list: any[] = [];
try { if (db) list = await db.select().from(farms); } catch {}
if (!list.length) {
  list = [{ id: "farm_adelphi", slug: "adelphi", name: "Adelphi Regenerative Farm", country: "Dominican Republic", region: "Gonzalo, Sabana Grande de Boyá, Monte Plata", areaM2: 15725, latitude: 18.9388, longitude: -69.7350, status: "active" }];
}
---
<BaseLayout title="Farms — Kokonut Foundation" description="Regenerative farms.">
  <section class="max-w-7xl mx-auto px-4 py-16">
    <script type="module">fetch("/api/v1/events",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({event:"farms_view"})}).catch(()=>{});</script>
    <h1 class="text-3xl md:text-5xl font-bold text-strong">{t("farms.title")}</h1>
    <p class="mt-4 text-muted">{t("farms.lede")}</p>
    <h2 class="sr-only">Farms</h2>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      {list.map((f: any) => (
        <a href={`/farms/${f.slug}`} class="block">
          <Card>
            <h3 class="font-semibold text-strong">{f.name}</h3>
            <p class="mt-1 text-xs text-muted">{f.region ? `${f.region}, ` : ""}{f.country}</p>
            {f.areaM2 && <p class="mt-2 text-sm text-muted">{f.areaM2.toLocaleString()} m²</p>}
            <p class="mt-2 text-xs text-muted">{f.status}</p>
          </Card>
        </a>
      ))}
    </div>
    <div class="mt-8" id="map" style="height:320px" data-farms={JSON.stringify(list)}></div>
  </section>
  <script>
    async function initMap() {
      const mod = await import("https://unpkg.com/leaflet@1.9.4/dist/leaflet-src.esm.js");
      const L = mod.default ?? mod;
      // markercluster ships UMD and expects a global `L`
      (window as any).L = L;
      await new Promise<void>((resolve, reject) => {
        const s = document.createElement("script");
        s.src = "https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js";
        s.onload = () => resolve();
        s.onerror = reject;
        document.head.appendChild(s);
      });
      const el = document.getElementById("map");
      if (!el) return;
      const farms = JSON.parse(el.dataset.farms || "[]");
      const map = L.map(el).setView([18.9, -69.7], 7);
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { attribution: "© OpenStreetMap" }).addTo(map);
      const cluster = L.markerClusterGroup ? L.markerClusterGroup() : null;
      for (const f of farms) {
        if (f.latitude && f.longitude) {
          const m = L.marker([f.latitude, f.longitude]);
          m.bindPopup(`<strong>${f.name}</strong><br/>${f.country ?? ""}`);
          if (cluster) cluster.addLayer(m); else m.addTo(map);
        }
      }
      if (cluster) map.addLayer(cluster);
    }
    initMap();
  </script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
</BaseLayout>
