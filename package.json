{
  "name": "kokonut-foundation",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Kokonut Foundation — Cloudflare-native web platform (Astro + Workers + D1)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply kokonut-foundation-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kokonut-foundation-db --remote",
    "db:seed:local": "wrangler d1 execute kokonut-foundation-db --local --file=./migrations/seed.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.0.0",
    "astro": "^5.1.0",
    "drizzle-orm": "^0.36.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@cloudflare/workers-types": "^4.20241205.0",
    "@tailwindcss/vite": "^4.3.3",
    "drizzle-kit": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.99.0"
  }
}
